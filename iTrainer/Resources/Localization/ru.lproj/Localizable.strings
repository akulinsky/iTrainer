"report.metric.volume_goal.title" = "Цель по объему";
"report.metric.volume_goal.description" = "Сравнивает выполненный объем с запланированным целевым объемом в упражнениях с весом. Объем - это общая работа: вес x повторения по завершенным сетам.";
"report.metric.volume_goal.formula" = "Фактический объем / целевой объем.";
