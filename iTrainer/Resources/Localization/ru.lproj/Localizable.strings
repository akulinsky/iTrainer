"report.metric.volume.title" = "Объем";
"report.metric.volume.description" = "Общая работа в упражнениях с весом. Объединяет вес и повторения в один показатель.";
"report.metric.volume.formula" = "Сумма веса x повторения по завершенным сетам.";
