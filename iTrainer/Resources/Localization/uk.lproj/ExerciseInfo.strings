/* Exercise Info */

"exercise.info.chest_bench_press.description" = "Жим штанги лежачи - базова вправа для розвитку сили грудних м'язів, плечей і трицепсів.";
"exercise.info.chest_bench_press.technique.1" = "Міцно поставте ноги на підлогу, перш ніж знімати штангу.";
"exercise.info.chest_bench_press.technique.2" = "Втягніть і опустіть лопатки, щоб створити стабільну верхню частину спини.";
"exercise.info.chest_bench_press.technique.3" = "Використовуйте хват трохи ширше ширини плечей, розташувавши зап’ястя над ліктями.";
"exercise.info.chest_bench_press.technique.4" = "Контрольовано опустіть штангу до нижньої або середньої частини грудей.";
"exercise.info.chest_bench_press.technique.5" = "Не відбивайте штангу від грудей і не піднімайте стегна з лави.";
"exercise.info.chest_bench_press.technique.6" = "Вичавлюйте штангу вгору рівномірно, зберігаючи напруження верхньої частини спини.";

"exercise.info.chest_incline_bench_press.description" = "Жим лежачи на нахилі – це жим штанги, який робить акцент на верхню частину грудей і передню частину плечей.";
"exercise.info.chest_incline_bench_press.technique.1" = "Встановіть лаву під помірним нахилом, зазвичай приблизно від 30 до 45 градусів.";
"exercise.info.chest_incline_bench_press.technique.2" = "Тримайте ноги стабільно, а лопатки притуліть до лави.";
"exercise.info.chest_incline_bench_press.technique.3" = "Візьміть штангу трохи ширше ширини плечей.";
"exercise.info.chest_incline_bench_press.technique.4" = "Контрольно опустіть штангу до верхньої частини грудей.";
"exercise.info.chest_incline_bench_press.technique.5" = "Тримайте лікті під контролем, а не розгортайте їх прямо.";
"exercise.info.chest_incline_bench_press.technique.6" = "Плавно вичавіть штангу вгору, не змінюючи положення на лаві.";

"exercise.info.chest_dumbbell_press.description" = "Жим гантелей — це варіант жиму грудьми, який дозволяє кожній руці працювати незалежно через природний діапазон рухів.";
"exercise.info.chest_dumbbell_press.technique.1" = "Сядьте, тримаючи гантелі в руках, а потім ляжте, приклавши їх до грудей.";
"exercise.info.chest_dumbbell_press.technique.2" = "Розставте лопатки та тримайте ноги на ногах.";
"exercise.info.chest_dumbbell_press.technique.3" = "Почніть із зап’ясть, складених над ліктями, а не зігнутих назад.";
"exercise.info.chest_dumbbell_press.technique.4" = "Опускайте обидві гантелі рівномірно, поки не відчуєте комфортне розтягування грудей.";
"exercise.info.chest_dumbbell_press.technique.5" = "Вичавіть гантелі вгору, не зіштовхуючи їх у верхній точці.";
"exercise.info.chest_dumbbell_press.technique.6" = "Слідкуйте, щоб обидві сторони рухалися рівномірно та уникайте поворотів тулуба.";

"exercise.info.chest_incline_dumbbell_press.description" = "Жим гантелей у нахилі розвиває силу верхньої частини грудей завдяки незалежним рухам рук і трохи більшому діапазону рухів.";
"exercise.info.chest_incline_dumbbell_press.technique.1" = "Використовуйте помірний нахил, щоб рух усе ще був зосереджений на грудях.";
"exercise.info.chest_incline_dumbbell_press.technique.2" = "Тримайте лопатки стабільними, а нижню частину спини контролюйте.";
"exercise.info.chest_incline_dumbbell_press.technique.3" = "Почніть з гантелей над верхньою частиною грудей.";
"exercise.info.chest_incline_dumbbell_press.technique.4" = "Опустіть гантелі біля верхньої частини грудей з контролем.";
"exercise.info.chest_incline_dumbbell_press.technique.5" = "Не дозволяйте ліктям занадто далеко відходити за плечі.";
"exercise.info.chest_incline_dumbbell_press.technique.6" = "Віджимайтеся плавно, не дозволяючи гантелям висуватися занадто далеко вперед.";

"exercise.info.chest_dips.description" = "Віджимання на брусах - вправа з власною вагою, яка зі злегка нахиленим уперед корпусом більше навантажує груди.";
"exercise.info.chest_dips.technique.1" = "Почніть з прямих рук і плечей, відведіть їх від вух.";
"exercise.info.chest_dips.technique.2" = "Злегка нахиліться вперед, щоб перенести більше роботи на груди.";
"exercise.info.chest_dips.technique.3" = "Опускайтеся під контролем, доки ваші плечі не будуть майже паралельні підлозі.";
"exercise.info.chest_dips.technique.4" = "Лікті тримайте в прямому положенні, а не розгортайте їх широко.";
"exercise.info.chest_dips.technique.5" = "Плавно віджимайтеся вгору без ривка з нижньої точки.";
"exercise.info.chest_dips.technique.6" = "Припиніть підхід, якщо відчуєте різкий дискомфорт у плечі.";

"exercise.info.chest_push_up.description" = "Віджимання — це вправа для віджимання власної ваги для контролю грудей, плечей, трицепсів і тулуба.";
"exercise.info.chest_push_up.technique.1" = "Розташуйте руки трохи ширше ширини плечей.";
"exercise.info.chest_push_up.technique.2" = "Тримайте тіло на прямій лінії від голови до п’ят.";
"exercise.info.chest_push_up.technique.3" = "Підтримуйте тулуб, щоб стегна не провисали і не піднімалися.";
"exercise.info.chest_push_up.technique.4" = "Контрольно опустіть груди до підлоги.";
"exercise.info.chest_push_up.technique.5" = "Тримайте лікті під зручним кутом, а не прямо в сторони.";
"exercise.info.chest_push_up.technique.6" = "Притисніться повністю, зберігаючи ту саму лінію тіла.";

"exercise.info.chest_machine_press.description" = "Тренажерний жим від грудей – це керована вправа віджиму, яка тренує силу грудей зі стабільною підтримкою тіла.";
"exercise.info.chest_machine_press.technique.1" = "Відрегулюйте сидіння так, щоб ручки знаходились посередині грудей.";
"exercise.info.chest_machine_press.technique.2" = "Тримайте спину та стегна на підкладці.";
"exercise.info.chest_machine_press.technique.3" = "Візьміться за ручки так, щоб зап’ястя були нейтральними, а плечі розслаблені.";
"exercise.info.chest_machine_press.technique.4" = "Плавно вичавлюйте руків'я вперед, не піднімаючи плечі.";
"exercise.info.chest_machine_press.technique.5" = "Уникайте агресивного змикання ліктів у кінці жиму.";
"exercise.info.chest_machine_press.technique.6" = "Поверніть ручки під контроль перед початком наступного повторення.";

"exercise.info.chest_smith_machine_press.description" = "Машинний жим Сміта – це керований жим штанги, який може допомогти тренувати груди з фіксованою траєкторією штанги.";
"exercise.info.chest_smith_machine_press.technique.1" = "Розташуйте лаву так, щоб штанга опускалася до середини або нижньої частини грудей.";
"exercise.info.chest_smith_machine_press.technique.2" = "Розставте лопатки та тримайте ноги стабільно.";
"exercise.info.chest_smith_machine_press.technique.3" = "Використовуйте хват, який тримає зап’ястя над ліктями.";
"exercise.info.chest_smith_machine_press.technique.4" = "Обережно розблокуйте планку та опустіть її з контролем.";
"exercise.info.chest_smith_machine_press.technique.5" = "Не змушуйте плечі рухатися незручною фіксованою траєкторією.";
"exercise.info.chest_smith_machine_press.technique.6" = "Плавно вичавіть штангу вгору та зафіксуйте її лише після повної зупинки.";

"exercise.info.chest_dumbbell_fly.description" = "Політ з гантелями – це ізолююча вправа, яка тренує груди за допомогою широкої дуги та розтяжки з навантаженням.";
"exercise.info.chest_dumbbell_fly.technique.1" = "Ляжте на спину, поклавши гантелі над грудьми, долонями один до одного.";
"exercise.info.chest_dumbbell_fly.technique.2" = "Тримайте злегка зігнуті лікті протягом усього руху.";
"exercise.info.chest_dumbbell_fly.technique.3" = "Повільно розкрийте руки, поки не відчуєте контрольоване розтягування грудей.";
"exercise.info.chest_dumbbell_fly.technique.4" = "Не опускайтеся настільки, щоб плечі відчували напругу.";
"exercise.info.chest_dumbbell_fly.technique.5" = "Знову зведіть гантелі разом через ту ж дугу.";
"exercise.info.chest_dumbbell_fly.technique.6" = "Зберігайте рух як мах, а не прихований жим гантелей.";

"exercise.info.chest_pec_deck.description" = "Pec Deck — це вправа на ізоляцію грудної клітки, у якій використовується керована траєкторія рук для тренування приведення грудної клітки.";
"exercise.info.chest_pec_deck.technique.1" = "Відрегулюйте сидіння так, щоб ручки або подушечки були на одній лінії з вашими грудьми.";
"exercise.info.chest_pec_deck.technique.2" = "Тримайте спину з підтримкою, а грудну клітку піднятою.";
"exercise.info.chest_pec_deck.technique.3" = "Тримайте ручки або подушечки, розслабивши плечі.";
"exercise.info.chest_pec_deck.technique.4" = "Плавно з’єднайте руки перед грудьми.";
"exercise.info.chest_pec_deck.technique.5" = "Зробіть коротку паузу, не дозволяючи плечам перекочуватися вперед.";
"exercise.info.chest_pec_deck.technique.6" = "Повільно повертайтеся, поки не відчуєте комфортне розтягування.";

"exercise.info.chest_cable_crossover.description" = "Cable Crossover — це вправа для ізоляції грудей, яка підтримує напругу в грудях у всьому діапазоні.";
"exercise.info.chest_cable_crossover.technique.1" = "Встановіть шківи на висоту, яка відповідає куту грудей, який ви хочете тренувати.";
"exercise.info.chest_cable_crossover.technique.2" = "Стійте стійко, злегка нахилившись вперед і однією ногою вперед, якщо потрібно.";
"exercise.info.chest_cable_crossover.technique.3" = "Тримайте лікті м’яко зігнутими, а плечі опущені.";
"exercise.info.chest_cable_crossover.technique.4" = "Рухайте руками по плавній дузі перед корпусом.";
"exercise.info.chest_cable_crossover.technique.5" = "Коротко стисніть груди, не округляючи плечі.";
"exercise.info.chest_cable_crossover.technique.6" = "Контролюйте повернення і не дозволяйте вазі тягнути вас назад.";

"exercise.info.chest_dumbbell_pullover.description" = "Пуловер з гантелями – це контрольована вправа для верхньої частини тіла, яка може тренувати груди та широкі м’язи за допомогою розгинання плечей.";
"exercise.info.chest_dumbbell_pullover.technique.1" = "Ляжте на лаву і міцно тримайте одну гантель двома руками.";
"exercise.info.chest_dumbbell_pullover.technique.2" = "Почніть з гантелі над грудьми і злегка зігнутими ліктями.";
"exercise.info.chest_dumbbell_pullover.technique.3" = "Опустіть гантель за голову настільки, наскільки дозволяють плечі.";
"exercise.info.chest_dumbbell_pullover.technique.4" = "Тримайте ребра та нижню частину спини під контролем замість надмірного вигину.";
"exercise.info.chest_dumbbell_pullover.technique.5" = "Потягніть гантель назад над грудьми плавною дугою.";
"exercise.info.chest_dumbbell_pullover.technique.6" = "Використовуйте помірне навантаження і уникайте перетворення руху в розгинання трицепса.";

"exercise.info.back_pull_up.description" = "Підтягування — це вправа з вертикальним підтягуванням ваги тіла для формування широких м’язів, сили верхньої частини спини та контролю рук.";
"exercise.info.back_pull_up.technique.1" = "Почніть з контрольованого вису з активними плечима, а не розпущеними.";
"exercise.info.back_pull_up.technique.2" = "Перед тим, як тягнути, міцно візьміться за штангу та скріпіть тулуб.";
"exercise.info.back_pull_up.technique.3" = "Потягніть, рухаючи ліктями вниз у бік.";
"exercise.info.back_pull_up.technique.4" = "Направте груди на штангу без надмірних розгойдувань.";
"exercise.info.back_pull_up.technique.5" = "Опускайтеся під контролем, доки руки знову не витягнуться.";
"exercise.info.back_pull_up.technique.6" = "Тримайте повторення чистими та уникайте ударів ногами для імпульсу.";

"exercise.info.back_reverse_grip_pull_up.description" = "Підтягування зворотним хватом — це підтягування в стилі підборіддя, яке наголошує на широких і біцепсах супінованим хватом.";
"exercise.info.back_reverse_grip_pull_up.technique.1" = "Використовуйте хват знизу приблизно на ширині плечей.";
"exercise.info.back_reverse_grip_pull_up.technique.2" = "Почніть з контрольованого вису з ребрами вниз.";
"exercise.info.back_reverse_grip_pull_up.technique.3" = "Підтягніть груди до штанги, тримаючи лікті близько.";
"exercise.info.back_reverse_grip_pull_up.technique.4" = "Уникайте витягування шиї, щоб дістатися до штанги.";
"exercise.info.back_reverse_grip_pull_up.technique.5" = "Повільно опускайтеся, поки лікті не будуть витягнуті.";
"exercise.info.back_reverse_grip_pull_up.technique.6" = "Не дозволяйте плечам опускатися внизу.";

"exercise.info.back_barbell_row.description" = "Тяга штанги в нахилі - базова горизонтальна тяга для середини спини, найширших м'язів і стабільності задньої поверхні тіла.";
"exercise.info.back_barbell_row.technique.1" = "Відведіть таз назад, нахиліться в кульшових суглобах і зберігайте нейтральне положення хребта.";
"exercise.info.back_barbell_row.technique.2" = "Підтягніть тулуб, перш ніж піднімати штангу з підлоги або стійки.";
"exercise.info.back_barbell_row.technique.3" = "Утримуйте кут тулуба стабільним протягом усього сету.";
"exercise.info.back_barbell_row.technique.4" = "Потягніть штангу до нижніх ребер або верхньої частини живота.";
"exercise.info.back_barbell_row.technique.5" = "Коротко стисніть спину, не риваючи вагу.";
"exercise.info.back_barbell_row.technique.6" = "Опустіть штангу під контролем, не округляючи спину.";

"exercise.info.back_one_arm_dumbbell_row.description" = "Тренування з гантелями однією рукою тренує кожну сторону спини незалежно з опорою на лаву або стійку поверхню.";
"exercise.info.back_one_arm_dumbbell_row.technique.1" = "Зіпріться однією рукою та коліном або однією рукою на стійку опору.";
"exercise.info.back_one_arm_dumbbell_row.technique.2" = "Тримайте хребет нейтральним, а тулуб – нерухомим.";
"exercise.info.back_one_arm_dumbbell_row.technique.3" = "Нехай робоче плече трохи досягає низу.";
"exercise.info.back_one_arm_dumbbell_row.technique.4" = "Тягніть гантель до стегна, а не прямо до плеча.";
"exercise.info.back_one_arm_dumbbell_row.technique.5" = "Зробіть коротку паузу, тримаючи лікоть близько до тіла.";
"exercise.info.back_one_arm_dumbbell_row.technique.6" = "Уникайте поворотів тулуба, щоб підняти більшу вагу.";

"exercise.info.back_lat_pulldown.description" = "Lat Pulldown – це вертикальна тяга на тросі, яка тренує широкі лати та верхню частину спини з регульованим навантаженням.";
"exercise.info.back_lat_pulldown.technique.1" = "Сядьте прямо і зафіксуйте стегна під накладкою.";
"exercise.info.back_lat_pulldown.technique.2" = "Візьміть штангу трохи ширше, ніж ширина плечей, якщо не використовується інше кріплення.";
"exercise.info.back_lat_pulldown.technique.3" = "Почніть з того, що опустіть плечі від вух.";
"exercise.info.back_lat_pulldown.technique.4" = "Потягніть штангу до верхньої частини грудей.";
"exercise.info.back_lat_pulldown.technique.5" = "Тримайте тулуб переважно стабільним і не нахиляйтеся далеко назад.";
"exercise.info.back_lat_pulldown.technique.6" = "Повільно повертайте штангу вгору, не втрачаючи контролю.";

"exercise.info.back_seated_cable_row.description" = "Сидячи на тросі – це горизонтальна вправа на тягу для середнього відділу спини, широких м’язів і контролю лопатки.";
"exercise.info.back_seated_cable_row.technique.1" = "Сидіть високо, хребет нейтральний, ноги підтримуються.";
"exercise.info.back_seated_cable_row.technique.2" = "Почніть з витягнутих рук, тримаючи груди піднятими.";
"exercise.info.back_seated_cable_row.technique.3" = "Потягніть ручку до нижніх ребер або верхньої частини живота.";
"exercise.info.back_seated_cable_row.technique.4" = "Відведіть лікті назад, не знизуючи плечима.";
"exercise.info.back_seated_cable_row.technique.5" = "Зробіть коротку паузу, контролюючи лопатки.";
"exercise.info.back_seated_cable_row.technique.6" = "Повільно поверніть рукоятку, не закругляючи вперед.";

"exercise.info.back_t_bar_row.description" = "T-Bar Row — важкий варіант веслування, який націлений на середню частину спини та широкі м’язи зі стабільною траєкторією тяги.";
"exercise.info.back_t_bar_row.technique.1" = "Прийміть стійке положення та нахиліться в кульшових суглобах, щоб корпус залишався нерухомим.";
"exercise.info.back_t_bar_row.technique.2" = "Перш ніж піднімати ручку, закріпіть тулуб.";
"exercise.info.back_t_bar_row.technique.3" = "Потягніть ручку до нижньої частини грудей або верхньої частини живота.";
