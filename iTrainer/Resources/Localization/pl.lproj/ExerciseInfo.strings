"exercise.info.triceps_dips.technique.3" = "Opuszczaj, aż ramiona i łokcie będą czuć się komfortowo.";
"exercise.info.triceps_dips.technique.4" = "Trzymaj łokcie skierowane do tyłu, zamiast rozszerzać się daleko.";
"exercise.info.triceps_dips.technique.5" = "Naciskaj uchwyty, aż ramiona będą prawie proste.";
"exercise.info.triceps_dips.technique.6" = "Używaj kontrolowanego tempa i unikaj podskakiwania na dole.";

"exercise.info.triceps_french_press.description" = "Wyciskanie francuskie w leżeniu to ćwiczenie izolacyjne tricepsa wykonywane na ławce ze sztangą EZ lub sztangą.";
