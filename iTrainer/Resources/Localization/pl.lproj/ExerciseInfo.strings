"exercise.info.triceps_cable_pushdown.technique.5" = "Ściśnij krótko w pobliżu dna.";
"exercise.info.triceps_cable_pushdown.technique.6" = "Wróć pod kontrolą, nie pozwalając łokciom dryfować do przodu.";

