"exercise.info.functional_training_wall_ball.technique.5" = "Złap piłkę miękko i zamortyzuj jej ciężar, przechodząc do kolejnego przysiadu.";
"exercise.info.functional_training_wall_ball.technique.6" = "Przez cały ruch utrzymuj kolana w jednej linii ze stopami.";

"exercise.info.functional_training_mountain_climber.description" = "Mountain Climber to ćwiczenie kondycyjne z masą własnego ciała, które polega na naprzemiennym wykonywaniu napędu kolan w pozycji deski.";
"exercise.info.functional_training_mountain_climber.technique.1" = "Zacznij od wysokiej deski z rękami pod ramionami.";
"exercise.info.functional_training_mountain_climber.technique.2" = "Napnij tułów, aby utrzymać stabilną pozycję.";
"exercise.info.functional_training_mountain_climber.technique.3" = "Przyciągnij jedno kolano do klatki piersiowej.";
"exercise.info.functional_training_mountain_climber.technique.4" = "Cofnij tę stopę i zmień strony pod kontrolą.";
"exercise.info.functional_training_mountain_climber.technique.5" = "Unikaj wysokiego podnoszenia bioder i opadania dolnej części pleców.";
"exercise.info.functional_training_mountain_climber.technique.6" = "Przed zwiększeniem prędkości zastosuj stały rytm.";

"exercise.info.functional_training_kettlebell_clean_and_press.description" = "Zarzut i wyciskanie kettlebell prowadzi odważnik do pozycji przy barku, a następnie nad głowę.";
"exercise.info.functional_training_kettlebell_clean_and_press.technique.1" = "Zacznij od odważnika na podłodze lub w kontrolowanym zwisie.";
"exercise.info.functional_training_kettlebell_clean_and_press.technique.2" = "Cofnij biodra i utrzymuj neutralne plecy.";
"exercise.info.functional_training_kettlebell_clean_and_press.technique.3" = "Dynamicznie wyprostuj biodra i poprowadź odważnik do pozycji przy barku.";
"exercise.info.functional_training_kettlebell_clean_and_press.technique.4" = "Pozwól odważnikowi obrócić się wokół nadgarstka, zamiast uderzać w przedramię.";
"exercise.info.functional_training_kettlebell_clean_and_press.technique.5" = "Napnij tułów i wyciśnij odważnik nad głowę pod pełną kontrolą.";
"exercise.info.functional_training_kettlebell_clean_and_press.technique.6" = "Opuść odważnik do barku i ustabilizuj pozycję przed kolejnym powtórzeniem.";

