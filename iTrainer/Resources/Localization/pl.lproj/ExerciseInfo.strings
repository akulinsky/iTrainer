"exercise.info.triceps_rope_pushdown.technique.3" = "Wyprostuj łokcie i oddziel końce liny u dołu.";
"exercise.info.triceps_rope_pushdown.technique.4" = "Trzymaj nadgarstki wygodnie i neutralnie.";
"exercise.info.triceps_rope_pushdown.technique.5" = "Nie machaj tułowiem, aby przenieść ciężar.";
"exercise.info.triceps_rope_pushdown.technique.6" = "Pozwól, aby lina wracała powoli, trzymając ramiona nieruchomo.";

