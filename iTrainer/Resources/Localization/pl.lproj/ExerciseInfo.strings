"exercise.info.biceps_spider_curl.technique.5" = "Opuszczaj powoli do pełnej kontroli.";
"exercise.info.biceps_spider_curl.technique.6" = "Użyj umiarkowanego obciążenia, aby ruch pozostał ścisły.";

"exercise.info.triceps_close_grip_bench_press.description" = "Wyciskanie sztangi wąskim chwytem to ćwiczenie złożone z naciskiem na tricepsy, angażujące także klatkę piersiową i barki.";
