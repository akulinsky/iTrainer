/* Exercise Info */

"exercise.info.chest_bench_press.description" = "Wyciskanie sztangi leżąc to podstawowe ćwiczenie rozwijające siłę klatki piersiowej, barków i tricepsów.";
"exercise.info.chest_bench_press.technique.1" = "Przed zdjęciem sztangi ze stojaka mocno oprzyj stopy na podłodze.";
"exercise.info.chest_bench_press.technique.2" = "Wciągnij i wciśnij łopatki, aby stworzyć stabilną górną część pleców.";
"exercise.info.chest_bench_press.technique.3" = "Użyj chwytu nieco szerszego niż szerokość ramion, z nadgarstkami ułożonymi nad łokciami.";
"exercise.info.chest_bench_press.technique.4" = "Opuść sztangę pod kontrolą w kierunku dolnej lub środkowej części klatki piersiowej.";
"exercise.info.chest_bench_press.technique.5" = "Nie odbijaj sztangi od klatki piersiowej ani nie unoś bioder nad ławkę.";
"exercise.info.chest_bench_press.technique.6" = "Wyciskaj sztangę równym ruchem, utrzymując napięcie górnej części pleców.";

"exercise.info.chest_incline_bench_press.description" = "Incline Bench Press to wyciskanie sztangi, które podkreśla górną część klatki piersiowej i przednie ramiona.";
"exercise.info.chest_incline_bench_press.technique.1" = "Ustaw ławkę pod umiarkowanym nachyleniem, zwykle około 30 do 45 stopni.";
"exercise.info.chest_incline_bench_press.technique.2" = "Trzymaj stopy stabilnie, a łopatki oparte o ławkę.";
"exercise.info.chest_incline_bench_press.technique.3" = "Chwyć drążek nieco szerzej niż szerokość barków.";
"exercise.info.chest_incline_bench_press.technique.4" = "Opuść sztangę pod kontrolą w kierunku górnej części klatki piersiowej.";
"exercise.info.chest_incline_bench_press.technique.5" = "Trzymaj łokcie pod kontrolą, zamiast rozszerzać je prosto.";
"exercise.info.chest_incline_bench_press.technique.6" = "Płynnie wyciśnij sztangę, nie zmieniając pozycji na ławce.";

"exercise.info.chest_dumbbell_press.description" = "Wyciskanie hantli to odmiana wyciskania na klatkę piersiową, która pozwala każdemu ramieniu pracować niezależnie w naturalnym zakresie ruchu.";
"exercise.info.chest_dumbbell_press.technique.1" = "Usiądź wygodnie z hantlami pod kontrolą, a następnie połóż się z nimi blisko klatki piersiowej.";
"exercise.info.chest_dumbbell_press.technique.2" = "Ustaw łopatki i trzymaj stopy wyprostowane.";
"exercise.info.chest_dumbbell_press.technique.3" = "Zacznij od nadgarstków ułożonych nad łokciami, a nie zgiętych do tyłu.";
"exercise.info.chest_dumbbell_press.technique.4" = "Opuść oba hantle równomiernie, aż poczujesz wygodne rozciąganie klatki piersiowej.";
"exercise.info.chest_dumbbell_press.technique.5" = "Wyciśnij w górę, nie pozwalając, aby hantle zderzyły się u góry.";
"exercise.info.chest_dumbbell_press.technique.6" = "Utrzymuj obie strony w równym ruchu i unikaj skręcania tułowia.";

"exercise.info.chest_incline_dumbbell_press.description" = "Wyciskanie hantli nachylonych rozwija siłę górnej części klatki piersiowej dzięki niezależnemu ruchowi ramion i nieco większemu zakresowi ruchu.";
"exercise.info.chest_incline_dumbbell_press.technique.1" = "Użyj umiarkowanego nachylenia, aby ruch nadal był skupiony na klatce piersiowej.";
"exercise.info.chest_incline_dumbbell_press.technique.2" = "Utrzymuj stabilne łopatki i kontrolowaną dolną część pleców.";
"exercise.info.chest_incline_dumbbell_press.technique.3" = "Zacznij od hantli nad górną klatką piersiową.";
"exercise.info.chest_incline_dumbbell_press.technique.4" = "Kontrolując opuść hantle obok górnej części klatki piersiowej.";
"exercise.info.chest_incline_dumbbell_press.technique.5" = "Nie pozwól, aby łokcie dryfowały zbyt daleko za ramionami.";
"exercise.info.chest_incline_dumbbell_press.technique.6" = "Wyciśnij płynnie do góry, nie pozwalając hantlom przesunąć się zbyt daleko do przodu.";

"exercise.info.chest_dips.description" = "Dipy to ćwiczenie polegające na wyciskaniu ciężaru ciała, które może uwypuklić klatkę piersiową, gdy jest wykonywane z lekkim pochyleniem do przodu.";
"exercise.info.chest_dips.technique.1" = "Zacznij od prostych ramion i barków, trzymanych z dala od uszu.";
"exercise.info.chest_dips.technique.2" = "Pochyl się lekko do przodu, aby przesunąć więcej pracy w stronę klatki piersiowej.";
"exercise.info.chest_dips.technique.3" = "Opuszczaj pod kontrolą, aż ramiona znajdą się prawie równolegle do podłogi.";
"exercise.info.chest_dips.technique.4" = "Utrzymuj łokcie w naturalnym ruchu, zamiast je rozszerzać.";
"exercise.info.chest_dips.technique.5" = "Płynnie odepchnij się w górę bez odbijania z dolnej pozycji.";
"exercise.info.chest_dips.technique.6" = "Zatrzymaj serię, jeśli poczujesz ostry dyskomfort w barku.";

"exercise.info.chest_push_up.description" = "Push-Up to ćwiczenie uciskające klatkę piersiową, ramiona, triceps i kontrolę tułowia z ciężarem własnego ciała.";
"exercise.info.chest_push_up.technique.1" = "Rozłóż dłonie nieco szerzej niż szerokość ramion.";
"exercise.info.chest_push_up.technique.2" = "Utrzymuj ciało w linii prostej od głowy do pięt.";
"exercise.info.chest_push_up.technique.3" = "Usztywnij tułów, aby biodra nie zwisały ani nie unosiły się.";
"exercise.info.chest_push_up.technique.4" = "Kontrolując opuść klatkę piersiową w kierunku podłogi.";
"exercise.info.chest_push_up.technique.5" = "Trzymaj łokcie pod wygodnym kątem, a nie prosto na boki.";
"exercise.info.chest_push_up.technique.6" = "Odepchnij się do pełnego wyprostu, zachowując prostą linię ciała.";

"exercise.info.chest_machine_press.description" = "Wyciskanie klatki piersiowej na maszynie to kontrolowane ćwiczenie wyciskające, które ćwiczy siłę klatki piersiowej przy stabilnym podparciu ciała.";
"exercise.info.chest_machine_press.technique.1" = "Wyreguluj siedzisko tak, aby uchwyty znajdowały się w jednej linii wokół połowy klatki piersiowej.";
"exercise.info.chest_machine_press.technique.2" = "Trzymaj plecy i biodra podparte na poduszce.";
"exercise.info.chest_machine_press.technique.3" = "Chwyć uchwyty z neutralnymi nadgarstkami i rozluźnionymi ramionami.";
"exercise.info.chest_machine_press.technique.4" = "Płynnie przesuwaj się do przodu, bez wzruszania ramionami.";
"exercise.info.chest_machine_press.technique.5" = "Unikaj agresywnego blokowania łokci na końcu wyciskania.";
"exercise.info.chest_machine_press.technique.6" = "Przywróć uchwyty pod kontrolą przed rozpoczęciem następnego powtórzenia.";

"exercise.info.chest_smith_machine_press.description" = "Wyciskanie na maszynie Smitha prowadzi sztangę po stałym torze i pozwala stabilnie trenować klatkę piersiową.";
"exercise.info.chest_smith_machine_press.technique.1" = "Ustaw ławkę tak, aby sztanga opadła do połowy lub dolnej części klatki piersiowej.";
"exercise.info.chest_smith_machine_press.technique.2" = "Ustaw łopatki i utrzymuj stopy stabilnie.";
"exercise.info.chest_smith_machine_press.technique.3" = "Użyj chwytu, który utrzymuje nadgarstki ułożone nad łokciami.";
"exercise.info.chest_smith_machine_press.technique.4" = "Ostrożnie odblokuj drążek i opuść go w sposób kontrolowany.";
"exercise.info.chest_smith_machine_press.technique.5" = "Nie zmuszaj ramion do poruszania się po niewygodnej, ustalonej ścieżce.";
"exercise.info.chest_smith_machine_press.technique.6" = "Dociśnij płynnie i ponownie ułóż na stojaku dopiero wtedy, gdy sztanga będzie w pełni kontrolowana.";

"exercise.info.chest_dumbbell_fly.description" = "Hantle Fly to ćwiczenie izolacyjne, które ćwiczy klatkę piersiową poprzez szeroki łuk i rozciąganie z obciążeniem.";
"exercise.info.chest_dumbbell_fly.technique.1" = "Połóż się z hantlami nad klatką piersiową i dłońmi skierowanymi do siebie.";
"exercise.info.chest_dumbbell_fly.technique.2" = "Podczas całego ruchu utrzymuj lekkie ugięcie łokci.";
"exercise.info.chest_dumbbell_fly.technique.3" = "Powoli otwieraj ramiona, aż poczujesz kontrolowane rozciąganie klatki piersiowej.";
"exercise.info.chest_dumbbell_fly.technique.4" = "Nie obniżaj się tak nisko, aby ramiona były napięte.";
"exercise.info.chest_dumbbell_fly.technique.5" = "Złącz hantle ponownie po tym samym łuku.";
"exercise.info.chest_dumbbell_fly.technique.6" = "Utrzymuj ruch jak muchę, a nie ukryte wyciskanie hantli.";

"exercise.info.chest_pec_deck.description" = "Pec Deck to maszynowe ćwiczenie izolujące klatkę piersiową, które wykorzystuje prowadzoną ścieżkę ramion do ćwiczenia przywodzenia klatki piersiowej.";
"exercise.info.chest_pec_deck.technique.1" = "Wyreguluj siedzisko tak, aby uchwyty lub podkładki znajdowały się w jednej linii z klatką piersiową.";
"exercise.info.chest_pec_deck.technique.2" = "Trzymaj plecy podparte i uniesioną klatkę piersiową.";
"exercise.info.chest_pec_deck.technique.3" = "Trzymaj uchwyty lub podkładki z rozluźnionymi ramionami.";
"exercise.info.chest_pec_deck.technique.4" = "Ramiona płynnie złącz przed klatką piersiową.";
"exercise.info.chest_pec_deck.technique.5" = "Zatrzymaj się na chwilę, nie pozwalając barkom przesunąć się do przodu.";
"exercise.info.chest_pec_deck.technique.6" = "Wróć powoli, aż poczujesz wygodne rozciąganie.";

"exercise.info.chest_cable_crossover.description" = "Cable Crossover to ćwiczenie izolujące klatkę piersiową, które utrzymuje napięcie klatki piersiowej w całym zakresie.";
"exercise.info.chest_cable_crossover.technique.1" = "Ustaw koła pasowe na wysokość odpowiadającą kątowi klatki piersiowej, który chcesz ćwiczyć.";
"exercise.info.chest_cable_crossover.technique.2" = "Stań stabilnie, lekko pochylając się do przodu i w razie potrzeby jedną stopą do przodu.";
"exercise.info.chest_cable_crossover.technique.3" = "Trzymaj łokcie lekko ugięte, a ramiona opuszczone.";
"exercise.info.chest_cable_crossover.technique.4" = "Poruszaj rękami po gładkim łuku przed ciałem.";
"exercise.info.chest_cable_crossover.technique.5" = "Ściśnij krótko klatkę piersiową, nie zaokrąglając ramion.";
"exercise.info.chest_cable_crossover.technique.6" = "Kontroluj powrót i nie pozwól, aby stos ciężarów cię odciągnął.";

"exercise.info.chest_dumbbell_pullover.description" = "Pullover z hantlami to kontrolowane ćwiczenie górnej części ciała, które może trenować klatkę piersiową i mięśnie grzbietu poprzez wyprost ramion.";
"exercise.info.chest_dumbbell_pullover.technique.1" = "Połóż się na ławce i mocno trzymaj jeden hantle obiema rękami.";
"exercise.info.chest_dumbbell_pullover.technique.2" = "Zacznij od hantli nad klatką piersiową i lekko ugiętych łokciach.";
"exercise.info.chest_dumbbell_pullover.technique.3" = "Opuść hantle za głowę tylko na tyle, na ile pozwalają na to ramiona.";
"exercise.info.chest_dumbbell_pullover.technique.4" = "Trzymaj żebra i dolną część pleców pod kontrolą, zamiast wyginać się ponad nie.";
"exercise.info.chest_dumbbell_pullover.technique.5" = "Pociągnij hantle z powrotem nad klatką piersiową gładkim łukiem.";
"exercise.info.chest_dumbbell_pullover.technique.6" = "Używaj umiarkowanego obciążenia i unikaj przekształcania ruchu w wyprost tricepsa.";

"exercise.info.back_pull_up.description" = "Podciąganie to ćwiczenie polegające na podciąganiu w pionie z ciężarem własnego ciała, służące budowaniu mięśni najszerszych mięśni grzbietu, siły górnej części pleców i kontroli ramion.";
"exercise.info.back_pull_up.technique.1" = "Zacznij od kontrolowanego zwisu z ramionami aktywnymi, a nie luźnymi.";
"exercise.info.back_pull_up.technique.2" = "Chwyć mocno drążek i podciągnij tułów przed pociągnięciem.";
"exercise.info.back_pull_up.technique.3" = "Pociągnij, kierując łokcie w dół w kierunku boków.";
"exercise.info.back_pull_up.technique.4" = "Skieruj klatkę piersiową w stronę drążka, bez nadmiernego kołysania.";
"exercise.info.back_pull_up.technique.5" = "Opuszczaj pod kontrolą, aż ramiona zostaną ponownie wyciągnięte.";
"exercise.info.back_pull_up.technique.6" = "Utrzymuj powtórzenia w czystości i unikaj kopania nóg w celu uzyskania pędu.";

"exercise.info.back_reverse_grip_pull_up.description" = "Podciąganie podchwytem mocno angażuje mięśnie najszersze grzbietu i bicepsy.";
"exercise.info.back_reverse_grip_pull_up.technique.1" = "Użyj chwytu podręcznego na szerokość ramion.";
"exercise.info.back_reverse_grip_pull_up.technique.2" = "Zacznij od kontrolowanego zwisu z żebrami w dół.";
"exercise.info.back_reverse_grip_pull_up.technique.3" = "Przyciągnij klatkę piersiową do drążka, trzymając łokcie blisko siebie.";
"exercise.info.back_reverse_grip_pull_up.technique.4" = "Unikaj wyciągania szyi, aby dosięgnąć drążka.";
"exercise.info.back_reverse_grip_pull_up.technique.5" = "Opuszczaj powoli, aż łokcie zostaną wyprostowane.";
"exercise.info.back_reverse_grip_pull_up.technique.6" = "Nie pozwól, aby ramiona opadły na dół.";

"exercise.info.back_barbell_row.description" = "Wiosłowanie ze sztangą w pozycji Bent-Over to złożone, poziome podciągnięcie, które zapewnia stabilność środkowej części pleców, mięśni najszerszych i tylnej części ciała.";
"exercise.info.back_barbell_row.technique.1" = "Zawiasy w biodrach i utrzymuj neutralny kręgosłup.";
"exercise.info.back_barbell_row.technique.2" = "Przed podniesieniem sztangi z podłogi lub stojaka usztywnij tułów.";
"exercise.info.back_barbell_row.technique.3" = "Utrzymuj stały kąt tułowia przez całą serię.";
"exercise.info.back_barbell_row.technique.4" = "Pociągnij drążek w kierunku dolnych żeber lub górnej części brzucha.";
"exercise.info.back_barbell_row.technique.5" = "Ściśnij krótko plecy, nie szarpiąc ciężarem.";
"exercise.info.back_barbell_row.technique.6" = "Opuszczaj sztangę pod kontrolą, bez zaokrąglania pleców.";

"exercise.info.back_one_arm_dumbbell_row.description" = "Jednoramienny wiosłowanie hantli trenuje każdą stronę pleców niezależnie, podpierając się ławką lub stabilną powierzchnią.";
"exercise.info.back_one_arm_dumbbell_row.technique.1" = "Oprzyj jedną rękę i kolano lub jedną rękę na stabilnym podparciu.";
"exercise.info.back_one_arm_dumbbell_row.technique.2" = "Utrzymuj kręgosłup w pozycji neutralnej, a tułów stabilnie.";
"exercise.info.back_one_arm_dumbbell_row.technique.3" = "Niech ramię robocze sięga nieco do dołu.";
"exercise.info.back_one_arm_dumbbell_row.technique.4" = "Pociągnij hantle w kierunku biodra, a nie prosto do barku.";
"exercise.info.back_one_arm_dumbbell_row.technique.5" = "Zatrzymaj się na chwilę, trzymając łokieć blisko ciała.";
"exercise.info.back_one_arm_dumbbell_row.technique.6" = "Unikaj skręcania tułowia, aby podnieść większy ciężar.";

"exercise.info.back_lat_pulldown.description" = "Lat Pulldown to pionowy wyciąg linowy, który trenuje mięśnie grzbietu i górną część pleców z regulowanym obciążeniem.";
"exercise.info.back_lat_pulldown.technique.1" = "Usiądź prosto i zabezpiecz uda pod poduszką.";
"exercise.info.back_lat_pulldown.technique.2" = "Chwyć drążek nieco szerzej niż szerokość ramion, chyba że używasz innego mocowania.";
"exercise.info.back_lat_pulldown.technique.3" = "Zacznij od opuszczenia ramion z dala od uszu.";
"exercise.info.back_lat_pulldown.technique.4" = "Pociągnij drążek w kierunku górnej części klatki piersiowej.";
"exercise.info.back_lat_pulldown.technique.5" = "Utrzymuj tułów w miarę stabilnie i unikaj odchylania się daleko do tyłu.";
"exercise.info.back_lat_pulldown.technique.6" = "Powoli opuszczaj sztangę w górę, nie tracąc kontroli.";

"exercise.info.back_seated_cable_row.description" = "Wiersz linowy w pozycji siedzącej to poziome ćwiczenie ciągnące dla kontroli środkowej części pleców, mięśni najszerszych i łopatek.";
"exercise.info.back_seated_cable_row.technique.1" = "Usiądź prosto, z neutralnym kręgosłupem i podpartymi stopami.";
"exercise.info.back_seated_cable_row.technique.2" = "Zacznij od wyprostowanych ramion, trzymając klatkę piersiową uniesioną.";
"exercise.info.back_seated_cable_row.technique.3" = "Pociągnij uchwyt w kierunku dolnych żeber lub górnej części brzucha.";
"exercise.info.back_seated_cable_row.technique.4" = "Odsuń łokcie do tyłu, nie wzruszając ramionami.";
"exercise.info.back_seated_cable_row.technique.5" = "Zatrzymaj się na chwilę, kontrolując łopatki.";
"exercise.info.back_seated_cable_row.technique.6" = "Opuść uchwyt powoli, bez zaokrąglania do przodu.";

"exercise.info.back_t_bar_row.description" = "T-Bar Row to odmiana ciężkiego wiosłowania, skupiająca się na środkowej części pleców i najszerszych mięśniach grzbietu, ze stabilną ścieżką naciągu.";
"exercise.info.back_t_bar_row.technique.1" = "Ustaw postawę i zawiasy tak, aby tułów pozostał stabilny.";
"exercise.info.back_t_bar_row.technique.2" = "Przed podniesieniem uchwytu usztywnij tułów.";
"exercise.info.back_t_bar_row.technique.3" = "Pociągnij uchwyt w stronę dolnej części klatki piersiowej lub górnej części brzucha.";
"exercise.info.back_t_bar_row.technique.4" = "Trzymaj łokcie cofając się, zamiast wzruszać ramionami.";
"exercise.info.back_t_bar_row.technique.5" = "Unikaj używania dużego zamachu tułowia na początku każdego powtórzenia.";
"exercise.info.back_t_bar_row.technique.6" = "Opuszczaj ciężar pod kontrolą, aż ramiona się wyprostują.";

"exercise.info.back_chest_supported_machine_row.description" = "Wiosłowanie maszynowe ze wsparciem klatki piersiowej ćwiczy plecy poprzez wsparcie tułowia, zmniejszając potrzebę stabilizacji dolnej części pleców.";
"exercise.info.back_chest_supported_machine_row.technique.1" = "Wyreguluj siedzisko lub nakładkę na klatkę piersiową tak, aby uchwyty były ustawione wygodnie.";
"exercise.info.back_chest_supported_machine_row.technique.2" = "Przez cały zestaw trzymaj klatkę piersiową przy podkładce.";
"exercise.info.back_chest_supported_machine_row.technique.3" = "Zacznij od wyprostowanych ramion i kontrolowanych ramion.";
"exercise.info.back_chest_supported_machine_row.technique.4" = "Pociągnij uchwyty do tyłu, kierując łokcie za siebie.";
"exercise.info.back_chest_supported_machine_row.technique.5" = "Zatrzymaj się na chwilę, nie odrywając klatki piersiowej od podkładki.";
"exercise.info.back_chest_supported_machine_row.technique.6" = "Wróć płynnie i utrzymuj napięcie w plecach.";

"exercise.info.back_straight_arm_pulldown.description" = "Podciąganie na prostych ramionach to ćwiczenie z linką dla mięśni najszerszych, które wykorzystuje ruch przypominający pulower z przeważnie prostymi ramionami.";
"exercise.info.back_straight_arm_pulldown.technique.1" = "Ustaw linkę wysoko i stój wystarczająco daleko, aby utrzymać napięcie.";
"exercise.info.back_straight_arm_pulldown.technique.2" = "Trzymaj drążek lub linę z lekko ugiętymi łokciami.";
"exercise.info.back_straight_arm_pulldown.technique.3" = "Usztywnij tułów i trzymaj ramiona z dala od uszu.";
"exercise.info.back_straight_arm_pulldown.technique.4" = "Pociągnij uchwyt w dół po łuku w kierunku górnej części ud.";
"exercise.info.back_straight_arm_pulldown.technique.5" = "Skoncentruj się na poruszaniu się od ramion, a nie zginaniu łokci jak przy wyciskaniu tricepsa.";
