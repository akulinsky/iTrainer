"exercise.info.triceps_french_press.technique.2" = "Trzymaj drążek nad ramionami za pomocą bezpiecznego, wygodnego uchwytu.";
"exercise.info.triceps_french_press.technique.3" = "Trzymaj ramiona prawie pionowo i stabilnie.";
"exercise.info.triceps_french_press.technique.4" = "Zegnij łokcie, aby opuścić sztangę w stronę czoła lub nieco za nim.";
"exercise.info.triceps_french_press.technique.5" = "Wyciągnij łokcie, aby cofnąć sztangę, nie zamieniając jej w wyciskanie na klatkę piersiową.";
"exercise.info.triceps_french_press.technique.6" = "Obniż ciężar pod kontrolą i użyj bezbolesnego zakresu dla łokci.";

"exercise.info.triceps_cable_pushdown.description" = "Cable Pushdown ćwiczy triceps przy stałym napięciu linki i jest jednym z najpopularniejszych ćwiczeń izolujących triceps.";
