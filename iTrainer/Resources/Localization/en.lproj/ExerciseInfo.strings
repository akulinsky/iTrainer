/* Exercise Info */

"exercise.info.chest_bench_press.description" = "Bench Press is a foundational barbell press for building chest, shoulder, and triceps strength.";
"exercise.info.chest_bench_press.technique.1" = "Plant your feet firmly on the floor before unracking the bar.";
"exercise.info.chest_bench_press.technique.2" = "Retract and depress your shoulder blades to create a stable upper back.";
"exercise.info.chest_bench_press.technique.3" = "Use a grip slightly wider than shoulder width with wrists stacked over elbows.";
"exercise.info.chest_bench_press.technique.4" = "Lower the bar under control toward the lower or mid chest.";
"exercise.info.chest_bench_press.technique.5" = "Do not bounce the bar off your chest or let your hips lift from the bench.";
"exercise.info.chest_bench_press.technique.6" = "Press the bar upward on a steady path while keeping your upper back tight.";

"exercise.info.chest_incline_bench_press.description" = "Incline Bench Press is a barbell press that emphasizes the upper chest and front shoulders.";
"exercise.info.chest_incline_bench_press.technique.1" = "Set the bench to a moderate incline, usually about 30 to 45 degrees.";
"exercise.info.chest_incline_bench_press.technique.2" = "Keep your feet stable and your shoulder blades set against the bench.";
"exercise.info.chest_incline_bench_press.technique.3" = "Grip the bar slightly wider than shoulder width.";
"exercise.info.chest_incline_bench_press.technique.4" = "Lower the bar under control toward the upper chest.";
"exercise.info.chest_incline_bench_press.technique.5" = "Keep elbows controlled instead of flaring them straight out.";
"exercise.info.chest_incline_bench_press.technique.6" = "Press smoothly upward without losing the bench position.";

"exercise.info.chest_dumbbell_press.description" = "Dumbbell Press is a chest press variation that lets each arm work independently through a natural range of motion.";
"exercise.info.chest_dumbbell_press.technique.1" = "Sit back with the dumbbells controlled, then lie down with them close to your chest.";
"exercise.info.chest_dumbbell_press.technique.2" = "Set your shoulder blades and keep your feet planted.";
"exercise.info.chest_dumbbell_press.technique.3" = "Start with wrists stacked over elbows, not bent backward.";
"exercise.info.chest_dumbbell_press.technique.4" = "Lower both dumbbells evenly until you feel a comfortable chest stretch.";
"exercise.info.chest_dumbbell_press.technique.5" = "Press upward without letting the dumbbells collide at the top.";
"exercise.info.chest_dumbbell_press.technique.6" = "Keep both sides moving evenly and avoid twisting your torso.";

"exercise.info.chest_incline_dumbbell_press.description" = "Incline Dumbbell Press develops upper-chest strength with independent arm movement and a slightly longer range of motion.";
"exercise.info.chest_incline_dumbbell_press.technique.1" = "Use a moderate incline so the movement still feels chest-focused.";
"exercise.info.chest_incline_dumbbell_press.technique.2" = "Keep your shoulder blades stable and your lower back controlled.";
"exercise.info.chest_incline_dumbbell_press.technique.3" = "Start with the dumbbells above the upper chest.";
"exercise.info.chest_incline_dumbbell_press.technique.4" = "Lower the dumbbells beside the upper chest with control.";
"exercise.info.chest_incline_dumbbell_press.technique.5" = "Do not let the elbows drift too far behind the shoulders.";
"exercise.info.chest_incline_dumbbell_press.technique.6" = "Press up smoothly without letting the dumbbells move too far forward.";

"exercise.info.chest_dips.description" = "Dips are a bodyweight pressing exercise that can emphasize the chest when performed with a slight forward lean.";
"exercise.info.chest_dips.technique.1" = "Start with straight arms and shoulders controlled away from your ears.";
"exercise.info.chest_dips.technique.2" = "Lean slightly forward to shift more work toward the chest.";
"exercise.info.chest_dips.technique.3" = "Lower under control until your upper arms are near parallel to the floor.";
"exercise.info.chest_dips.technique.4" = "Keep elbows tracking naturally instead of flaring them wide.";
"exercise.info.chest_dips.technique.5" = "Press up smoothly without bouncing from the bottom.";
"exercise.info.chest_dips.technique.6" = "Stop the set if you feel sharp shoulder discomfort.";

"exercise.info.chest_push_up.description" = "Push-Up is a bodyweight pressing exercise for the chest, shoulders, triceps, and trunk control.";
"exercise.info.chest_push_up.technique.1" = "Place your hands slightly wider than shoulder width.";
"exercise.info.chest_push_up.technique.2" = "Keep your body in a straight line from head to heels.";
"exercise.info.chest_push_up.technique.3" = "Brace your trunk so the hips do not sag or rise.";
"exercise.info.chest_push_up.technique.4" = "Lower your chest toward the floor with control.";
"exercise.info.chest_push_up.technique.5" = "Keep elbows at a comfortable angle, not straight out to the sides.";
"exercise.info.chest_push_up.technique.6" = "Press up fully while maintaining the same body line.";

"exercise.info.chest_machine_press.description" = "Machine Chest Press is a guided pressing exercise that trains chest strength with stable body support.";
"exercise.info.chest_machine_press.technique.1" = "Adjust the seat so the handles line up around mid chest.";
"exercise.info.chest_machine_press.technique.2" = "Keep your back and hips supported against the pad.";
"exercise.info.chest_machine_press.technique.3" = "Grip the handles with wrists neutral and shoulders relaxed.";
"exercise.info.chest_machine_press.technique.4" = "Press forward smoothly without shrugging.";
"exercise.info.chest_machine_press.technique.5" = "Avoid locking the elbows aggressively at the end of the press.";
"exercise.info.chest_machine_press.technique.6" = "Return the handles under control before starting the next rep.";

"exercise.info.chest_smith_machine_press.description" = "Smith Machine Press is a guided barbell press that can help train the chest with a fixed bar path.";
"exercise.info.chest_smith_machine_press.technique.1" = "Position the bench so the bar lowers to the mid or lower chest.";
"exercise.info.chest_smith_machine_press.technique.2" = "Set your shoulder blades and keep your feet stable.";
"exercise.info.chest_smith_machine_press.technique.3" = "Use a grip that keeps wrists stacked over elbows.";
"exercise.info.chest_smith_machine_press.technique.4" = "Unlock the bar carefully and lower it with control.";
"exercise.info.chest_smith_machine_press.technique.5" = "Do not force your shoulders into an uncomfortable fixed path.";
"exercise.info.chest_smith_machine_press.technique.6" = "Press up smoothly and re-rack only when the bar is fully controlled.";

"exercise.info.chest_dumbbell_fly.description" = "Dumbbell Fly is an isolation exercise that trains the chest through a wide arc and loaded stretch.";
"exercise.info.chest_dumbbell_fly.technique.1" = "Lie back with dumbbells above the chest and palms facing each other.";
"exercise.info.chest_dumbbell_fly.technique.2" = "Keep a slight bend in the elbows throughout the movement.";
"exercise.info.chest_dumbbell_fly.technique.3" = "Open your arms slowly until you feel a controlled chest stretch.";
"exercise.info.chest_dumbbell_fly.technique.4" = "Do not lower so far that the shoulders feel strained.";
"exercise.info.chest_dumbbell_fly.technique.5" = "Bring the dumbbells back together through the same arc.";
"exercise.info.chest_dumbbell_fly.technique.6" = "Keep the movement as a fly, not a hidden dumbbell press.";

"exercise.info.chest_pec_deck.description" = "Pec Deck is a machine chest isolation exercise that uses a guided arm path to train chest adduction.";
"exercise.info.chest_pec_deck.technique.1" = "Adjust the seat so the handles or pads align with your chest.";
"exercise.info.chest_pec_deck.technique.2" = "Keep your back supported and chest lifted.";
"exercise.info.chest_pec_deck.technique.3" = "Hold the handles or pads with shoulders relaxed.";
"exercise.info.chest_pec_deck.technique.4" = "Bring the arms together smoothly in front of the chest.";
"exercise.info.chest_pec_deck.technique.5" = "Pause briefly without letting the shoulders roll forward.";
"exercise.info.chest_pec_deck.technique.6" = "Return slowly until you feel a comfortable stretch.";

"exercise.info.chest_cable_crossover.description" = "Cable Crossover is a chest isolation exercise that keeps tension on the chest through the full range.";
"exercise.info.chest_cable_crossover.technique.1" = "Set the pulleys to the height that matches the chest angle you want to train.";
"exercise.info.chest_cable_crossover.technique.2" = "Stand stable with a slight forward lean and one foot forward if needed.";
"exercise.info.chest_cable_crossover.technique.3" = "Keep elbows softly bent and shoulders down.";
"exercise.info.chest_cable_crossover.technique.4" = "Move your hands in a smooth arc in front of the body.";
"exercise.info.chest_cable_crossover.technique.5" = "Squeeze the chest briefly without rounding the shoulders.";
"exercise.info.chest_cable_crossover.technique.6" = "Control the return and avoid letting the weight stack pull you back.";

"exercise.info.chest_dumbbell_pullover.description" = "Dumbbell Pullover is a controlled upper-body exercise that can train the chest and lats through shoulder extension.";
"exercise.info.chest_dumbbell_pullover.technique.1" = "Lie on a bench and hold one dumbbell securely with both hands.";
"exercise.info.chest_dumbbell_pullover.technique.2" = "Start with the dumbbell above the chest and elbows slightly bent.";
"exercise.info.chest_dumbbell_pullover.technique.3" = "Lower the dumbbell behind your head only as far as your shoulders allow.";
"exercise.info.chest_dumbbell_pullover.technique.4" = "Keep ribs and lower back controlled instead of over-arching.";
"exercise.info.chest_dumbbell_pullover.technique.5" = "Pull the dumbbell back over the chest with a smooth arc.";
"exercise.info.chest_dumbbell_pullover.technique.6" = "Use a moderate load and avoid turning the movement into a triceps extension.";

"exercise.info.back_pull_up.description" = "Pull-Up is a bodyweight vertical pulling exercise for building lats, upper-back strength, and arm control.";
"exercise.info.back_pull_up.technique.1" = "Start from a controlled hang with shoulders active, not loose.";
"exercise.info.back_pull_up.technique.2" = "Grip the bar firmly and brace your trunk before pulling.";
"exercise.info.back_pull_up.technique.3" = "Pull by driving elbows down toward your sides.";
"exercise.info.back_pull_up.technique.4" = "Aim your chest toward the bar without excessive swinging.";
"exercise.info.back_pull_up.technique.5" = "Lower under control until the arms are extended again.";
"exercise.info.back_pull_up.technique.6" = "Keep reps clean and avoid kicking the legs for momentum.";

"exercise.info.back_reverse_grip_pull_up.description" = "Reverse-Grip Pull-Up is a chin-up style pull that emphasizes the lats and biceps with a supinated grip.";
"exercise.info.back_reverse_grip_pull_up.technique.1" = "Use an underhand grip about shoulder width.";
"exercise.info.back_reverse_grip_pull_up.technique.2" = "Start from a controlled hang with your ribs down.";
"exercise.info.back_reverse_grip_pull_up.technique.3" = "Pull your chest toward the bar while keeping elbows close.";
"exercise.info.back_reverse_grip_pull_up.technique.4" = "Avoid craning the neck to reach the bar.";
"exercise.info.back_reverse_grip_pull_up.technique.5" = "Lower slowly until the elbows are extended.";
"exercise.info.back_reverse_grip_pull_up.technique.6" = "Do not let the shoulders collapse at the bottom.";

"exercise.info.back_barbell_row.description" = "Bent-Over Barbell Row is a compound horizontal pull for the mid-back, lats, and posterior chain stability.";
"exercise.info.back_barbell_row.technique.1" = "Hinge at the hips and keep a neutral spine.";
"exercise.info.back_barbell_row.technique.2" = "Brace your torso before lifting the bar from the floor or rack.";
"exercise.info.back_barbell_row.technique.3" = "Hold the torso angle steady throughout the set.";
"exercise.info.back_barbell_row.technique.4" = "Pull the bar toward the lower ribs or upper abdomen.";
"exercise.info.back_barbell_row.technique.5" = "Squeeze the back briefly without jerking the weight.";
"exercise.info.back_barbell_row.technique.6" = "Lower the bar under control without rounding your back.";

"exercise.info.back_one_arm_dumbbell_row.description" = "One-Arm Dumbbell Row trains each side of the back independently with support from a bench or stable surface.";
"exercise.info.back_one_arm_dumbbell_row.technique.1" = "Brace one hand and knee or one hand on a stable support.";
"exercise.info.back_one_arm_dumbbell_row.technique.2" = "Keep your spine neutral and torso steady.";
"exercise.info.back_one_arm_dumbbell_row.technique.3" = "Let the working shoulder reach slightly at the bottom.";
"exercise.info.back_one_arm_dumbbell_row.technique.4" = "Pull the dumbbell toward your hip, not straight up to the shoulder.";
"exercise.info.back_one_arm_dumbbell_row.technique.5" = "Pause briefly while keeping the elbow close to the body.";
"exercise.info.back_one_arm_dumbbell_row.technique.6" = "Avoid twisting your torso to lift heavier weight.";

"exercise.info.back_lat_pulldown.description" = "Lat Pulldown is a vertical cable pull that trains the lats and upper back with adjustable load.";
"exercise.info.back_lat_pulldown.technique.1" = "Sit tall and secure your thighs under the pad.";
"exercise.info.back_lat_pulldown.technique.2" = "Grip the bar slightly wider than shoulder width unless using another attachment.";
"exercise.info.back_lat_pulldown.technique.3" = "Start by setting the shoulders down away from the ears.";
"exercise.info.back_lat_pulldown.technique.4" = "Pull the bar toward the upper chest.";
"exercise.info.back_lat_pulldown.technique.5" = "Keep the torso mostly stable and avoid leaning far back.";
"exercise.info.back_lat_pulldown.technique.6" = "Return the bar upward slowly without losing control.";

"exercise.info.back_seated_cable_row.description" = "Seated Cable Row is a horizontal pulling exercise for the mid-back, lats, and scapular control.";
"exercise.info.back_seated_cable_row.technique.1" = "Sit tall with a neutral spine and feet supported.";
"exercise.info.back_seated_cable_row.technique.2" = "Start with arms extended while keeping the chest lifted.";
"exercise.info.back_seated_cable_row.technique.3" = "Pull the handle toward the lower ribs or upper abdomen.";
"exercise.info.back_seated_cable_row.technique.4" = "Drive elbows back without shrugging the shoulders.";
"exercise.info.back_seated_cable_row.technique.5" = "Pause briefly with shoulder blades controlled.";
"exercise.info.back_seated_cable_row.technique.6" = "Return the handle slowly without rounding forward.";

"exercise.info.back_t_bar_row.description" = "T-Bar Row is a heavy rowing variation that targets the mid-back and lats with a stable pulling path.";
"exercise.info.back_t_bar_row.technique.1" = "Set your stance and hinge so your torso stays stable.";
"exercise.info.back_t_bar_row.technique.2" = "Brace your trunk before lifting the handle.";
"exercise.info.back_t_bar_row.technique.3" = "Pull the handle toward the lower chest or upper abdomen.";
"exercise.info.back_t_bar_row.technique.4" = "Keep elbows driving back instead of letting shoulders shrug.";
"exercise.info.back_t_bar_row.technique.5" = "Avoid using a big torso swing to start each rep.";
"exercise.info.back_t_bar_row.technique.6" = "Lower the weight under control until the arms extend.";

"exercise.info.back_chest_supported_machine_row.description" = "Chest-Supported Machine Row trains the back with torso support, reducing the need to stabilize the lower back.";
"exercise.info.back_chest_supported_machine_row.technique.1" = "Adjust the seat or chest pad so the handles align comfortably.";
"exercise.info.back_chest_supported_machine_row.technique.2" = "Keep your chest against the pad throughout the set.";
"exercise.info.back_chest_supported_machine_row.technique.3" = "Start with arms extended and shoulders controlled.";
"exercise.info.back_chest_supported_machine_row.technique.4" = "Pull the handles back by driving elbows behind you.";
"exercise.info.back_chest_supported_machine_row.technique.5" = "Pause briefly without lifting your chest off the pad.";
"exercise.info.back_chest_supported_machine_row.technique.6" = "Return smoothly and keep tension on the back.";

"exercise.info.back_straight_arm_pulldown.description" = "Straight-Arm Pulldown is a cable exercise for the lats that uses a pullover-style motion with mostly straight arms.";
"exercise.info.back_straight_arm_pulldown.technique.1" = "Set a cable high and stand far enough back to keep tension.";
"exercise.info.back_straight_arm_pulldown.technique.2" = "Hold the bar or rope with elbows softly bent.";
"exercise.info.back_straight_arm_pulldown.technique.3" = "Brace your torso and keep shoulders away from the ears.";
"exercise.info.back_straight_arm_pulldown.technique.4" = "Pull the handle down in an arc toward the upper thighs.";
"exercise.info.back_straight_arm_pulldown.technique.5" = "Focus on moving from the shoulders, not bending the elbows like a triceps pressdown.";
"exercise.info.back_straight_arm_pulldown.technique.6" = "Return slowly until you feel a controlled stretch in the lats.";

"exercise.info.back_deadlift.description" = "Deadlift is a heavy hip-hinge exercise that develops full-body pulling strength and posterior-chain power.";
"exercise.info.back_deadlift.technique.1" = "Set your feet under the bar with the bar close to mid-foot.";
"exercise.info.back_deadlift.technique.2" = "Hinge down, grip the bar, and brace your torso hard.";
"exercise.info.back_deadlift.technique.3" = "Keep the bar close to your legs as you start the pull.";
"exercise.info.back_deadlift.technique.4" = "Push through the floor while keeping your back neutral.";
"exercise.info.back_deadlift.technique.5" = "Lock out by extending hips and knees together.";
"exercise.info.back_deadlift.technique.6" = "Avoid leaning back excessively at the top.";

"exercise.info.back_hyperextension.description" = "Hyperextension trains controlled hip extension, glutes, hamstrings, and lower-back endurance.";
"exercise.info.back_hyperextension.technique.1" = "Set the pad so your hips can move freely.";
"exercise.info.back_hyperextension.technique.2" = "Cross your arms or hold a load close to the body.";
"exercise.info.back_hyperextension.technique.3" = "Lower your torso with a neutral spine.";
"exercise.info.back_hyperextension.technique.4" = "Raise back up by squeezing the glutes and hamstrings.";
"exercise.info.back_hyperextension.technique.5" = "Stop when your body is in line, not hyperextended backward.";
"exercise.info.back_hyperextension.technique.6" = "Move slowly and avoid swinging through the reps.";

"exercise.info.back_dumbbell_shrug.description" = "Dumbbell Shrug trains the upper trapezius with each arm loaded independently.";
"exercise.info.back_dumbbell_shrug.technique.1" = "Stand tall with a dumbbell in each hand.";
"exercise.info.back_dumbbell_shrug.technique.2" = "Keep arms straight and let the weights hang at your sides.";
"exercise.info.back_dumbbell_shrug.technique.3" = "Raise your shoulders straight up toward your ears.";
"exercise.info.back_dumbbell_shrug.technique.4" = "Pause briefly at the top without rolling the shoulders.";
"exercise.info.back_dumbbell_shrug.technique.5" = "Lower under control to a full stretch.";
"exercise.info.back_dumbbell_shrug.technique.6" = "Keep your neck neutral and avoid bouncing the weight.";

"exercise.info.back_barbell_shrug.description" = "Barbell Shrug is an upper-trap exercise that allows heavier loading with a barbell.";
"exercise.info.back_barbell_shrug.technique.1" = "Hold the bar in front of your thighs with a firm grip.";
"exercise.info.back_barbell_shrug.technique.2" = "Stand tall with your trunk braced.";
"exercise.info.back_barbell_shrug.technique.3" = "Lift your shoulders straight up without bending the elbows.";
"exercise.info.back_barbell_shrug.technique.4" = "Pause briefly at the top and keep the bar close.";
"exercise.info.back_barbell_shrug.technique.5" = "Lower the bar under control instead of dropping into the bottom.";
"exercise.info.back_barbell_shrug.technique.6" = "Do not roll the shoulders; move up and down.";

"exercise.info.legs_barbell_squat.description" = "Barbell Squat is a foundational lower-body strength exercise for the quads, glutes, and full-body stability.";
"exercise.info.legs_barbell_squat.technique.1" = "Set the bar securely on your upper back and grip it evenly.";
"exercise.info.legs_barbell_squat.technique.2" = "Place your feet about shoulder width and brace your torso.";
"exercise.info.legs_barbell_squat.technique.3" = "Lower by bending hips and knees together.";
"exercise.info.legs_barbell_squat.technique.4" = "Keep knees tracking in line with your feet.";
"exercise.info.legs_barbell_squat.technique.5" = "Maintain a neutral spine and avoid collapsing forward.";
"exercise.info.legs_barbell_squat.technique.6" = "Drive up through the mid-foot until hips and knees extend.";

"exercise.info.legs_leg_press.description" = "Leg Press is a machine exercise for training the legs with the back supported and load guided by the sled.";
"exercise.info.legs_leg_press.technique.1" = "Place your feet firmly on the platform at a comfortable width.";
"exercise.info.legs_leg_press.technique.2" = "Keep your hips and lower back against the pad.";
"exercise.info.legs_leg_press.technique.3" = "Unlock the sled only when you are stable.";
"exercise.info.legs_leg_press.technique.4" = "Lower the platform until your knees bend comfortably.";
"exercise.info.legs_leg_press.technique.5" = "Press through the whole foot without letting knees collapse inward.";
"exercise.info.legs_leg_press.technique.6" = "Avoid locking the knees aggressively at the top.";

"exercise.info.legs_squat.description" = "Squat is a bodyweight lower-body movement for leg strength, mobility, and movement control.";
"exercise.info.legs_squat.technique.1" = "Stand with feet around shoulder width.";
"exercise.info.legs_squat.technique.2" = "Brace your torso and keep your chest lifted.";
"exercise.info.legs_squat.technique.3" = "Lower by sitting between your hips.";
"exercise.info.legs_squat.technique.4" = "Keep knees tracking in line with your toes.";
"exercise.info.legs_squat.technique.5" = "Go as low as you can while keeping control.";
"exercise.info.legs_squat.technique.6" = "Stand up smoothly through the mid-foot.";

"exercise.info.legs_dumbbell_lunge.description" = "Dumbbell Lunge is a single-leg exercise for the quads, glutes, balance, and leg control.";
"exercise.info.legs_dumbbell_lunge.technique.1" = "Hold dumbbells at your sides and stand tall.";
"exercise.info.legs_dumbbell_lunge.technique.2" = "Step forward or backward with control.";
"exercise.info.legs_dumbbell_lunge.technique.3" = "Lower until both knees bend naturally.";
"exercise.info.legs_dumbbell_lunge.technique.4" = "Keep the front knee tracking over the foot.";
"exercise.info.legs_dumbbell_lunge.technique.5" = "Push through the front foot to return.";
"exercise.info.legs_dumbbell_lunge.technique.6" = "Keep the torso steady and avoid wobbling side to side.";

"exercise.info.legs_barbell_lunge.description" = "Barbell Lunge is a loaded single-leg exercise that challenges leg strength, balance, and trunk stability.";
"exercise.info.legs_barbell_lunge.technique.1" = "Set the bar securely on your upper back.";
"exercise.info.legs_barbell_lunge.technique.2" = "Brace your torso before stepping.";
"exercise.info.legs_barbell_lunge.technique.3" = "Step with control and keep the bar level.";
"exercise.info.legs_barbell_lunge.technique.4" = "Lower until both knees bend comfortably.";
"exercise.info.legs_barbell_lunge.technique.5" = "Push through the front foot without letting the knee collapse inward.";
"exercise.info.legs_barbell_lunge.technique.6" = "Use a lighter load if balance breaks down.";

"exercise.info.legs_hack_squat.description" = "Hack Squat is a machine squat variation that emphasizes the quads with a guided path and supported torso.";
"exercise.info.legs_hack_squat.technique.1" = "Set your shoulders and back firmly against the pads.";
"exercise.info.legs_hack_squat.technique.2" = "Place your feet on the platform at a comfortable stance.";
"exercise.info.legs_hack_squat.technique.3" = "Unlock the machine only after bracing.";
"exercise.info.legs_hack_squat.technique.4" = "Lower under control while knees follow the toes.";
"exercise.info.legs_hack_squat.technique.5" = "Press through the platform without lifting your heels.";
"exercise.info.legs_hack_squat.technique.6" = "Avoid hard knee lockout at the top.";

"exercise.info.legs_front_squat.description" = "Front Squat is a squat variation with the bar held in front, emphasizing the quads and upright torso control.";
"exercise.info.legs_front_squat.technique.1" = "Rest the bar on the front of your shoulders with elbows lifted.";
"exercise.info.legs_front_squat.technique.2" = "Brace your torso and keep your chest tall.";
"exercise.info.legs_front_squat.technique.3" = "Lower by bending hips and knees together.";
"exercise.info.legs_front_squat.technique.4" = "Keep elbows high so the bar does not roll forward.";
"exercise.info.legs_front_squat.technique.5" = "Drive up through the mid-foot.";
"exercise.info.legs_front_squat.technique.6" = "Use a load you can control without collapsing forward.";

"exercise.info.legs_leg_extension.description" = "Leg Extension is a machine isolation exercise for the quadriceps.";
"exercise.info.legs_leg_extension.technique.1" = "Adjust the seat so the machine pivot aligns with your knee.";
"exercise.info.legs_leg_extension.technique.2" = "Set the pad just above the ankles.";
"exercise.info.legs_leg_extension.technique.3" = "Hold the handles and keep hips down.";
"exercise.info.legs_leg_extension.technique.4" = "Extend the legs smoothly without swinging.";
"exercise.info.legs_leg_extension.technique.5" = "Pause briefly near the top if comfortable.";
"exercise.info.legs_leg_extension.technique.6" = "Lower the weight slowly and keep tension on the quads.";

"exercise.info.legs_lying_leg_curl.description" = "Lying Leg Curl is a machine isolation exercise for the hamstrings performed face down.";
"exercise.info.legs_lying_leg_curl.technique.1" = "Lie face down and align your knees with the machine pivot.";
"exercise.info.legs_lying_leg_curl.technique.2" = "Set the pad just above your heels.";
"exercise.info.legs_lying_leg_curl.technique.3" = "Keep hips pressed into the pad.";
"exercise.info.legs_lying_leg_curl.technique.4" = "Curl the weight toward your glutes with control.";
"exercise.info.legs_lying_leg_curl.technique.5" = "Avoid lifting the hips to finish the rep.";
"exercise.info.legs_lying_leg_curl.technique.6" = "Lower slowly until the legs are extended.";

"exercise.info.legs_seated_leg_curl.description" = "Seated Leg Curl is a hamstring isolation exercise performed with the hips flexed and torso supported.";
"exercise.info.legs_seated_leg_curl.technique.1" = "Adjust the seat so your knees align with the machine pivot.";
"exercise.info.legs_seated_leg_curl.technique.2" = "Secure the thigh pad comfortably above the knees.";
"exercise.info.legs_seated_leg_curl.technique.3" = "Keep your hips and back against the seat.";
"exercise.info.legs_seated_leg_curl.technique.4" = "Curl the pad down with control.";
"exercise.info.legs_seated_leg_curl.technique.5" = "Pause briefly in the contracted position.";
"exercise.info.legs_seated_leg_curl.technique.6" = "Return slowly without letting the weight stack slam.";

"exercise.info.legs_standing_calf_raise.description" = "Standing Calf Raise trains the calves through ankle extension with the legs mostly straight.";
"exercise.info.legs_standing_calf_raise.technique.1" = "Stand tall with the balls of your feet on the platform or floor.";
"exercise.info.legs_standing_calf_raise.technique.2" = "Keep knees mostly straight but not locked hard.";
"exercise.info.legs_standing_calf_raise.technique.3" = "Lower heels under control to a comfortable stretch.";
"exercise.info.legs_standing_calf_raise.technique.4" = "Rise onto your toes through the full range.";
"exercise.info.legs_standing_calf_raise.technique.5" = "Pause briefly at the top.";
"exercise.info.legs_standing_calf_raise.technique.6" = "Avoid bouncing through the reps.";

"exercise.info.legs_seated_calf_raise.description" = "Seated Calf Raise trains the calves with the knees bent, often emphasizing the soleus.";
"exercise.info.legs_seated_calf_raise.technique.1" = "Sit with the balls of your feet on the platform.";
"exercise.info.legs_seated_calf_raise.technique.2" = "Position the pad comfortably over the thighs.";
"exercise.info.legs_seated_calf_raise.technique.3" = "Lower the heels slowly to a comfortable stretch.";
"exercise.info.legs_seated_calf_raise.technique.4" = "Press through the balls of the feet to raise the heels.";
"exercise.info.legs_seated_calf_raise.technique.5" = "Pause briefly at the top.";
"exercise.info.legs_seated_calf_raise.technique.6" = "Keep the motion controlled and avoid bouncing.";

"exercise.info.legs_hip_adduction_machine.description" = "Hip Adduction Machine trains the inner thighs by bringing the legs toward the midline.";
"exercise.info.legs_hip_adduction_machine.technique.1" = "Sit tall and adjust the pads to a comfortable starting width.";
"exercise.info.legs_hip_adduction_machine.technique.2" = "Keep your back supported against the seat.";
"exercise.info.legs_hip_adduction_machine.technique.3" = "Hold the handles and brace lightly.";
"exercise.info.legs_hip_adduction_machine.technique.4" = "Bring the legs together smoothly.";
"exercise.info.legs_hip_adduction_machine.technique.5" = "Pause briefly without forcing the range.";
"exercise.info.legs_hip_adduction_machine.technique.6" = "Return slowly and keep control of the pads.";

"exercise.info.glutes_hip_thrust.description" = "Hip Thrust is a loaded glute exercise performed with the upper back supported on a bench.";
"exercise.info.glutes_hip_thrust.technique.1" = "Place your upper back against a bench and set the bar over your hips.";
"exercise.info.glutes_hip_thrust.technique.2" = "Keep feet about hip width and close enough that shins are near vertical at the top.";
"exercise.info.glutes_hip_thrust.technique.3" = "Brace your trunk before lifting the hips.";
"exercise.info.glutes_hip_thrust.technique.4" = "Drive through the heels and lift until hips are fully extended.";
"exercise.info.glutes_hip_thrust.technique.5" = "Pause briefly at the top and squeeze the glutes.";
"exercise.info.glutes_hip_thrust.technique.6" = "Lower under control without over-arching the lower back.";

"exercise.info.glutes_glute_bridge.description" = "Glute Bridge is a floor-based glute exercise with a shorter range of motion than a hip thrust.";
"exercise.info.glutes_glute_bridge.technique.1" = "Lie on your back with knees bent and feet flat on the floor.";
"exercise.info.glutes_glute_bridge.technique.2" = "Place feet about hip width and keep ribs controlled.";
"exercise.info.glutes_glute_bridge.technique.3" = "Drive through the heels to lift your hips.";
"exercise.info.glutes_glute_bridge.technique.4" = "Stop when hips are extended and the body forms a straight line.";
"exercise.info.glutes_glute_bridge.technique.5" = "Squeeze the glutes at the top without arching the back.";
"exercise.info.glutes_glute_bridge.technique.6" = "Lower slowly until the hips return to the floor.";

"exercise.info.glutes_romanian_deadlift.description" = "Romanian Deadlift is a hip-hinge exercise that trains the glutes, hamstrings, and posterior-chain control.";
"exercise.info.glutes_romanian_deadlift.technique.1" = "Stand tall with the weight in front of your thighs.";
"exercise.info.glutes_romanian_deadlift.technique.2" = "Brace your torso and keep the knees softly bent.";
"exercise.info.glutes_romanian_deadlift.technique.3" = "Hinge at the hips and push them back.";
"exercise.info.glutes_romanian_deadlift.technique.4" = "Keep the weight close to your legs as it lowers.";
"exercise.info.glutes_romanian_deadlift.technique.5" = "Lower until you feel a controlled stretch in the hamstrings.";
"exercise.info.glutes_romanian_deadlift.technique.6" = "Stand back up by driving the hips forward.";

"exercise.info.glutes_bulgarian_split_squat.description" = "Bulgarian Split Squat is a single-leg exercise that can strongly train the glutes and quads.";
"exercise.info.glutes_bulgarian_split_squat.technique.1" = "Place the rear foot on a bench or stable support.";
"exercise.info.glutes_bulgarian_split_squat.technique.2" = "Set the front foot far enough forward to control knee position.";
"exercise.info.glutes_bulgarian_split_squat.technique.3" = "Keep the torso slightly leaned forward if targeting the glutes.";
"exercise.info.glutes_bulgarian_split_squat.technique.4" = "Lower under control until the front leg bends comfortably.";
"exercise.info.glutes_bulgarian_split_squat.technique.5" = "Push through the front foot to stand up.";
"exercise.info.glutes_bulgarian_split_squat.technique.6" = "Keep balance steady and avoid bouncing from the bottom.";

"exercise.info.glutes_cable_kickback.description" = "Cable Kickback trains the glutes by extending the hip backward against cable resistance.";
"exercise.info.glutes_cable_kickback.technique.1" = "Attach the cable cuff near the ankle and hold the machine for support.";
"exercise.info.glutes_cable_kickback.technique.2" = "Stand tall with a slight forward lean and brace your trunk.";
"exercise.info.glutes_cable_kickback.technique.3" = "Move the working leg backward from the hip.";
"exercise.info.glutes_cable_kickback.technique.4" = "Keep the pelvis stable and avoid rotating the torso.";
"exercise.info.glutes_cable_kickback.technique.5" = "Pause briefly when the glute contracts.";
"exercise.info.glutes_cable_kickback.technique.6" = "Return slowly without letting the weight pull the leg forward.";

"exercise.info.glutes_leg_kickback.description" = "Leg Kickback is a bodyweight or banded glute movement focused on hip extension.";
"exercise.info.glutes_leg_kickback.technique.1" = "Start from a stable standing or hands-and-knees position.";
"exercise.info.glutes_leg_kickback.technique.2" = "Brace your trunk so the lower back does not over-arch.";
"exercise.info.glutes_leg_kickback.technique.3" = "Drive one leg backward from the hip.";
"exercise.info.glutes_leg_kickback.technique.4" = "Keep the pelvis square and avoid twisting.";
"exercise.info.glutes_leg_kickback.technique.5" = "Squeeze the glute briefly at the end of the movement.";
"exercise.info.glutes_leg_kickback.technique.6" = "Return with control before starting the next rep.";

"exercise.info.glutes_abduction_machine.description" = "Hip Abduction Machine trains the glute medius and outer glutes by moving the legs away from the midline.";
"exercise.info.glutes_abduction_machine.technique.1" = "Sit with your back supported and pads placed outside the thighs.";
"exercise.info.glutes_abduction_machine.technique.2" = "Choose a starting width that feels comfortable.";
"exercise.info.glutes_abduction_machine.technique.3" = "Hold the handles and keep the torso steady.";
"exercise.info.glutes_abduction_machine.technique.4" = "Open the legs outward under control.";
"exercise.info.glutes_abduction_machine.technique.5" = "Pause briefly without leaning or using momentum.";
"exercise.info.glutes_abduction_machine.technique.6" = "Return slowly and keep tension on the glutes.";

"exercise.info.glutes_step_up.description" = "Step-Up is a single-leg exercise that trains the glutes, quads, and balance by stepping onto a raised platform.";
"exercise.info.glutes_step_up.technique.1" = "Choose a platform height you can control.";
"exercise.info.glutes_step_up.technique.2" = "Place the full working foot on the platform.";
"exercise.info.glutes_step_up.technique.3" = "Lean slightly forward and brace your torso.";
"exercise.info.glutes_step_up.technique.4" = "Push through the working foot to step up.";
"exercise.info.glutes_step_up.technique.5" = "Avoid pushing hard off the trailing leg.";
"exercise.info.glutes_step_up.technique.6" = "Step down slowly and repeat with control.";

"exercise.info.glutes_cable_side_kick.description" = "Cable Side Kick trains the outer glutes by moving the leg sideways against cable resistance.";
"exercise.info.glutes_cable_side_kick.technique.1" = "Attach the cable cuff near the ankle and stand side-on to the machine.";
"exercise.info.glutes_cable_side_kick.technique.2" = "Hold the machine for balance and keep the torso tall.";
"exercise.info.glutes_cable_side_kick.technique.3" = "Move the working leg out to the side from the hip.";
"exercise.info.glutes_cable_side_kick.technique.4" = "Keep the pelvis stable and avoid leaning far away.";
"exercise.info.glutes_cable_side_kick.technique.5" = "Pause briefly at the end of the range.";
"exercise.info.glutes_cable_side_kick.technique.6" = "Return slowly without letting the cable pull you out of position.";

"exercise.info.shoulders_overhead_press.description" = "Overhead Press is a compound shoulder exercise that develops vertical pressing strength and trunk stability.";
"exercise.info.shoulders_overhead_press.technique.1" = "Stand with feet stable and the bar near the upper chest.";
"exercise.info.shoulders_overhead_press.technique.2" = "Brace your torso and keep ribs controlled.";
"exercise.info.shoulders_overhead_press.technique.3" = "Press the bar upward in a mostly straight path.";
"exercise.info.shoulders_overhead_press.technique.4" = "Move your head slightly back, then through as the bar passes.";
"exercise.info.shoulders_overhead_press.technique.5" = "Finish with the bar over shoulders, hips, and mid-foot.";
"exercise.info.shoulders_overhead_press.technique.6" = "Lower under control without leaning back excessively.";

"exercise.info.shoulders_seated_dumbbell_press.description" = "Seated Dumbbell Press builds shoulder pressing strength with independent arm movement and stable torso support.";
"exercise.info.shoulders_seated_dumbbell_press.technique.1" = "Sit tall with your back supported and feet planted.";
"exercise.info.shoulders_seated_dumbbell_press.technique.2" = "Start with dumbbells near shoulder level.";
"exercise.info.shoulders_seated_dumbbell_press.technique.3" = "Keep wrists stacked over elbows.";
"exercise.info.shoulders_seated_dumbbell_press.technique.4" = "Press upward without letting the lower back over-arch.";
"exercise.info.shoulders_seated_dumbbell_press.technique.5" = "Do not bang the dumbbells together at the top.";
"exercise.info.shoulders_seated_dumbbell_press.technique.6" = "Lower both dumbbells evenly with control.";

"exercise.info.shoulders_machine_press.description" = "Machine Shoulder Press trains vertical pressing strength with a guided path and stable body support.";
"exercise.info.shoulders_machine_press.technique.1" = "Adjust the seat so the handles start around shoulder height.";
"exercise.info.shoulders_machine_press.technique.2" = "Keep your back and hips supported against the pad.";
"exercise.info.shoulders_machine_press.technique.3" = "Grip the handles with wrists neutral.";
"exercise.info.shoulders_machine_press.technique.4" = "Press upward smoothly without shrugging.";
"exercise.info.shoulders_machine_press.technique.5" = "Avoid locking the elbows aggressively.";
"exercise.info.shoulders_machine_press.technique.6" = "Return the handles under control before the next rep.";

"exercise.info.shoulders_arnold_press.description" = "Arnold Press is a dumbbell shoulder press variation that combines rotation with an overhead press.";
"exercise.info.shoulders_arnold_press.technique.1" = "Start seated or standing with dumbbells in front of the shoulders.";
"exercise.info.shoulders_arnold_press.technique.2" = "Begin with palms facing you and elbows in front.";
"exercise.info.shoulders_arnold_press.technique.3" = "Rotate the dumbbells outward as you press overhead.";
"exercise.info.shoulders_arnold_press.technique.4" = "Keep the motion smooth and controlled.";
"exercise.info.shoulders_arnold_press.technique.5" = "Avoid excessive back arch during the press.";
"exercise.info.shoulders_arnold_press.technique.6" = "Reverse the rotation as you lower to the start.";

"exercise.info.shoulders_lateral_raise.description" = "Lateral Raise is an isolation exercise for the side delts and shoulder width.";
"exercise.info.shoulders_lateral_raise.technique.1" = "Stand tall with a slight bend in your elbows.";
"exercise.info.shoulders_lateral_raise.technique.2" = "Raise the dumbbells out to the sides with control.";
"exercise.info.shoulders_lateral_raise.technique.3" = "Lead with elbows rather than hands.";
"exercise.info.shoulders_lateral_raise.technique.4" = "Stop around shoulder height.";
"exercise.info.shoulders_lateral_raise.technique.5" = "Lower slowly without dropping the weights.";
"exercise.info.shoulders_lateral_raise.technique.6" = "Avoid swinging your torso to start the rep.";

"exercise.info.shoulders_cable_lateral_raise.description" = "Cable Lateral Raise trains the side delts with constant cable tension through the range of motion.";
"exercise.info.shoulders_cable_lateral_raise.technique.1" = "Set the cable low and stand side-on to the machine.";
"exercise.info.shoulders_cable_lateral_raise.technique.2" = "Hold the handle with the outside hand and brace your torso.";
"exercise.info.shoulders_cable_lateral_raise.technique.3" = "Keep a soft bend in the elbow.";
"exercise.info.shoulders_cable_lateral_raise.technique.4" = "Raise the arm out to the side to about shoulder height.";
"exercise.info.shoulders_cable_lateral_raise.technique.5" = "Control the return and keep tension on the cable.";
"exercise.info.shoulders_cable_lateral_raise.technique.6" = "Do not lean or twist to lift more weight.";

"exercise.info.shoulders_front_raise.description" = "Front Raise trains the front delts through controlled shoulder flexion.";
"exercise.info.shoulders_front_raise.technique.1" = "Stand tall and brace your torso.";
"exercise.info.shoulders_front_raise.technique.2" = "Hold the weights in front of your thighs.";
"exercise.info.shoulders_front_raise.technique.3" = "Raise the weight forward to about shoulder height.";
"exercise.info.shoulders_front_raise.technique.4" = "Keep elbows softly bent and wrists neutral.";
"exercise.info.shoulders_front_raise.technique.5" = "Lower slowly without leaning backward.";
"exercise.info.shoulders_front_raise.technique.6" = "Avoid swinging the weight from the hips.";

"exercise.info.shoulders_reverse_fly.description" = "Reverse Fly trains the rear delts and upper-back control through horizontal arm movement.";
"exercise.info.shoulders_reverse_fly.technique.1" = "Hinge at the hips or lie chest-down on an incline bench.";
"exercise.info.shoulders_reverse_fly.technique.2" = "Keep a soft bend in the elbows.";
"exercise.info.shoulders_reverse_fly.technique.3" = "Open the arms out to the sides.";
"exercise.info.shoulders_reverse_fly.technique.4" = "Focus on the rear delts rather than shrugging.";
"exercise.info.shoulders_reverse_fly.technique.5" = "Pause briefly at the top if controlled.";
"exercise.info.shoulders_reverse_fly.technique.6" = "Lower slowly without letting the weights swing.";

"exercise.info.shoulders_reverse_pec_deck.description" = "Reverse Pec Deck is a machine exercise for the rear delts and upper-back stability.";
"exercise.info.shoulders_reverse_pec_deck.technique.1" = "Adjust the seat so the handles are around shoulder height.";
"exercise.info.shoulders_reverse_pec_deck.technique.2" = "Sit facing the pad with chest supported.";
"exercise.info.shoulders_reverse_pec_deck.technique.3" = "Grip the handles and keep shoulders down.";
"exercise.info.shoulders_reverse_pec_deck.technique.4" = "Open the arms back in a wide arc.";
"exercise.info.shoulders_reverse_pec_deck.technique.5" = "Pause briefly without leaning away from the pad.";
"exercise.info.shoulders_reverse_pec_deck.technique.6" = "Return slowly and keep control of the stack.";

"exercise.info.shoulders_upright_row.description" = "Upright Row trains the shoulders and upper traps with a vertical pulling motion.";
"exercise.info.shoulders_upright_row.technique.1" = "Hold the bar or dumbbells in front of your thighs.";
"exercise.info.shoulders_upright_row.technique.2" = "Keep the weight close to your body.";
"exercise.info.shoulders_upright_row.technique.3" = "Pull upward with elbows leading.";
"exercise.info.shoulders_upright_row.technique.4" = "Stop around lower chest or upper chest height.";
"exercise.info.shoulders_upright_row.technique.5" = "Lower under control without swinging.";
"exercise.info.shoulders_upright_row.technique.6" = "Stop if the movement feels uncomfortable in the shoulders.";

"exercise.info.shoulders_face_pull.description" = "Face Pull is a cable exercise for rear delts, external rotators, and upper-back control.";
"exercise.info.shoulders_face_pull.technique.1" = "Set the cable around upper chest or face height.";
"exercise.info.shoulders_face_pull.technique.2" = "Use a rope attachment and step back to create tension.";
"exercise.info.shoulders_face_pull.technique.3" = "Pull the rope toward your face with elbows high.";
"exercise.info.shoulders_face_pull.technique.4" = "Separate the rope ends as you pull.";
"exercise.info.shoulders_face_pull.technique.5" = "Keep ribs down and avoid leaning back.";
"exercise.info.shoulders_face_pull.technique.6" = "Return slowly with shoulders controlled.";

"exercise.info.biceps_barbell_curl.description" = "Barbell Curl is a classic biceps exercise that trains elbow flexion with both arms working together.";
"exercise.info.biceps_barbell_curl.technique.1" = "Stand tall with feet stable and the bar in front of your thighs.";
"exercise.info.biceps_barbell_curl.technique.2" = "Keep elbows close to your sides.";
"exercise.info.biceps_barbell_curl.technique.3" = "Curl the bar upward without swinging your torso.";
"exercise.info.biceps_barbell_curl.technique.4" = "Keep wrists neutral and avoid bending them back.";
"exercise.info.biceps_barbell_curl.technique.5" = "Squeeze briefly near the top.";
"exercise.info.biceps_barbell_curl.technique.6" = "Lower slowly until the arms are extended with control.";

"exercise.info.biceps_ez_bar_curl.description" = "EZ-Bar Curl is a biceps curl variation that uses an angled bar to reduce wrist strain for many lifters.";
"exercise.info.biceps_ez_bar_curl.technique.1" = "Hold the EZ-bar with a comfortable angled grip.";
"exercise.info.biceps_ez_bar_curl.technique.2" = "Stand tall and brace your torso.";
"exercise.info.biceps_ez_bar_curl.technique.3" = "Keep elbows near your sides throughout the rep.";
"exercise.info.biceps_ez_bar_curl.technique.4" = "Curl the bar smoothly without leaning back.";
"exercise.info.biceps_ez_bar_curl.technique.5" = "Pause briefly near the top if controlled.";
"exercise.info.biceps_ez_bar_curl.technique.6" = "Lower under control and avoid relaxing at the bottom.";

"exercise.info.biceps_dumbbell_curl.description" = "Dumbbell Curl trains the biceps with independent arm movement and a natural wrist path.";
"exercise.info.biceps_dumbbell_curl.technique.1" = "Stand or sit tall with dumbbells at your sides.";
"exercise.info.biceps_dumbbell_curl.technique.2" = "Keep elbows close to your torso.";
"exercise.info.biceps_dumbbell_curl.technique.3" = "Curl both dumbbells smoothly through the full range.";
"exercise.info.biceps_dumbbell_curl.technique.4" = "Rotate the palms up if using a supinating curl.";
"exercise.info.biceps_dumbbell_curl.technique.5" = "Avoid leaning back or swinging the weights.";
"exercise.info.biceps_dumbbell_curl.technique.6" = "Lower with control until arms are extended.";

"exercise.info.biceps_alternating_dumbbell_curl.description" = "Alternating Dumbbell Curl trains each arm one at a time while keeping the movement controlled.";
"exercise.info.biceps_alternating_dumbbell_curl.technique.1" = "Hold dumbbells at your sides and stand tall.";
"exercise.info.biceps_alternating_dumbbell_curl.technique.2" = "Curl one dumbbell while the other arm stays still.";
"exercise.info.biceps_alternating_dumbbell_curl.technique.3" = "Keep the working elbow close to your side.";
"exercise.info.biceps_alternating_dumbbell_curl.technique.4" = "Control the wrist and avoid twisting the shoulder forward.";
"exercise.info.biceps_alternating_dumbbell_curl.technique.5" = "Lower fully before switching arms.";
"exercise.info.biceps_alternating_dumbbell_curl.technique.6" = "Keep reps even between both sides.";

"exercise.info.biceps_hammer_curl.description" = "Hammer Curl uses a neutral grip to train the biceps, brachialis, and forearm muscles.";
"exercise.info.biceps_hammer_curl.technique.1" = "Hold the dumbbells with palms facing each other.";
"exercise.info.biceps_hammer_curl.technique.2" = "Keep elbows near your sides.";
"exercise.info.biceps_hammer_curl.technique.3" = "Curl without rotating the wrists.";
"exercise.info.biceps_hammer_curl.technique.4" = "Lift until the forearms are near vertical.";
"exercise.info.biceps_hammer_curl.technique.5" = "Avoid swinging the dumbbells forward.";
"exercise.info.biceps_hammer_curl.technique.6" = "Lower slowly and keep the grip neutral.";

"exercise.info.biceps_preacher_curl.description" = "Preacher Curl supports the upper arms on a pad to isolate the biceps and limit body momentum.";
"exercise.info.biceps_preacher_curl.technique.1" = "Set the seat so your upper arms rest fully on the pad.";
"exercise.info.biceps_preacher_curl.technique.2" = "Keep the chest close to the bench.";
"exercise.info.biceps_preacher_curl.technique.3" = "Start with elbows slightly bent, not forcefully locked.";
"exercise.info.biceps_preacher_curl.technique.4" = "Curl the weight without lifting the upper arms from the pad.";
"exercise.info.biceps_preacher_curl.technique.5" = "Pause briefly near the top.";
"exercise.info.biceps_preacher_curl.technique.6" = "Lower slowly and avoid dropping into the bottom.";

"exercise.info.biceps_dumbbell_preacher_curl.description" = "Dumbbell Preacher Curl is a single-arm preacher variation for stricter side-to-side biceps work.";
"exercise.info.biceps_dumbbell_preacher_curl.technique.1" = "Place one upper arm firmly on the preacher pad.";
"exercise.info.biceps_dumbbell_preacher_curl.technique.2" = "Hold the dumbbell with the wrist neutral.";
"exercise.info.biceps_dumbbell_preacher_curl.technique.3" = "Curl without lifting the elbow from the pad.";
"exercise.info.biceps_dumbbell_preacher_curl.technique.4" = "Keep the movement slow and strict.";
"exercise.info.biceps_dumbbell_preacher_curl.technique.5" = "Lower until the arm is extended but not relaxed.";
"exercise.info.biceps_dumbbell_preacher_curl.technique.6" = "Repeat the same range and control on both arms.";

"exercise.info.biceps_incline_dumbbell_curl.description" = "Incline Dumbbell Curl stretches the biceps by curling with the arms behind the torso on an incline bench.";
"exercise.info.biceps_incline_dumbbell_curl.technique.1" = "Set the bench to a moderate incline.";
"exercise.info.biceps_incline_dumbbell_curl.technique.2" = "Let the arms hang down with shoulders relaxed.";
"exercise.info.biceps_incline_dumbbell_curl.technique.3" = "Keep elbows mostly fixed as you curl.";
"exercise.info.biceps_incline_dumbbell_curl.technique.4" = "Curl through a comfortable range without swinging.";
"exercise.info.biceps_incline_dumbbell_curl.technique.5" = "Avoid letting the shoulders roll forward.";
"exercise.info.biceps_incline_dumbbell_curl.technique.6" = "Lower slowly to feel a controlled stretch.";

"exercise.info.biceps_concentration_curl.description" = "Concentration Curl is a strict single-arm curl focused on controlled biceps contraction.";
"exercise.info.biceps_concentration_curl.technique.1" = "Sit and brace the upper arm against the inner thigh.";
"exercise.info.biceps_concentration_curl.technique.2" = "Start with the arm extended under control.";
"exercise.info.biceps_concentration_curl.technique.3" = "Curl the dumbbell without moving the shoulder.";
"exercise.info.biceps_concentration_curl.technique.4" = "Pause briefly near the top.";
"exercise.info.biceps_concentration_curl.technique.5" = "Lower slowly and keep the rep strict.";
"exercise.info.biceps_concentration_curl.technique.6" = "Avoid twisting the torso to finish the rep.";

"exercise.info.biceps_cable_curl.description" = "Cable Curl trains the biceps with constant cable tension through the movement.";
"exercise.info.biceps_cable_curl.technique.1" = "Stand stable facing the cable stack.";
"exercise.info.biceps_cable_curl.technique.2" = "Keep elbows close to your sides.";
"exercise.info.biceps_cable_curl.technique.3" = "Curl the handle smoothly toward the chest.";
"exercise.info.biceps_cable_curl.technique.4" = "Keep shoulders down and torso still.";
"exercise.info.biceps_cable_curl.technique.5" = "Squeeze briefly near the top.";
"exercise.info.biceps_cable_curl.technique.6" = "Control the return without letting the stack drop.";

"exercise.info.biceps_spider_curl.description" = "Spider Curl is a strict curl variation performed chest-down on an incline bench to limit momentum.";
"exercise.info.biceps_spider_curl.technique.1" = "Lie chest-down on an incline bench with arms hanging.";
"exercise.info.biceps_spider_curl.technique.2" = "Keep the chest supported and shoulders relaxed.";
"exercise.info.biceps_spider_curl.technique.3" = "Curl the weight without moving the upper arms much.";
"exercise.info.biceps_spider_curl.technique.4" = "Pause briefly at the top.";
"exercise.info.biceps_spider_curl.technique.5" = "Lower slowly to full control.";
"exercise.info.biceps_spider_curl.technique.6" = "Use a moderate load so the movement stays strict.";

"exercise.info.triceps_close_grip_bench_press.description" = "Close-Grip Bench Press is a compound press that emphasizes the triceps while still using the chest and shoulders.";
"exercise.info.triceps_close_grip_bench_press.technique.1" = "Lie with your eyes under the bar and feet planted firmly.";
"exercise.info.triceps_close_grip_bench_press.technique.2" = "Grip the bar slightly narrower than shoulder width.";
"exercise.info.triceps_close_grip_bench_press.technique.3" = "Keep shoulder blades pulled back and down on the bench.";
"exercise.info.triceps_close_grip_bench_press.technique.4" = "Lower the bar under control toward the lower chest.";
"exercise.info.triceps_close_grip_bench_press.technique.5" = "Keep elbows closer to the body, not flared wide.";
"exercise.info.triceps_close_grip_bench_press.technique.6" = "Press up smoothly without losing upper-back tightness.";

"exercise.info.triceps_dips.description" = "Dips train the triceps strongly with bodyweight or added weight, especially when the torso stays more upright.";
"exercise.info.triceps_dips.technique.1" = "Start on parallel bars with arms straight and shoulders controlled.";
"exercise.info.triceps_dips.technique.2" = "Keep the torso relatively upright to emphasize the triceps.";
"exercise.info.triceps_dips.technique.3" = "Lower until the shoulders and elbows feel comfortable.";
"exercise.info.triceps_dips.technique.4" = "Keep elbows tracking back instead of flaring far out.";
"exercise.info.triceps_dips.technique.5" = "Press through the handles until the arms are nearly straight.";
"exercise.info.triceps_dips.technique.6" = "Use a controlled tempo and avoid bouncing at the bottom.";

"exercise.info.triceps_french_press.description" = "French Press isolates the triceps with an elbow-extension movement, usually using a barbell or EZ-bar.";
"exercise.info.triceps_french_press.technique.1" = "Lie or sit stable with the weight held above you.";
"exercise.info.triceps_french_press.technique.2" = "Keep upper arms mostly fixed during the movement.";
"exercise.info.triceps_french_press.technique.3" = "Bend the elbows and lower the weight toward the forehead or behind the head.";
"exercise.info.triceps_french_press.technique.4" = "Use a range that feels comfortable for the elbows.";
"exercise.info.triceps_french_press.technique.5" = "Extend the elbows without letting the shoulders take over.";
"exercise.info.triceps_french_press.technique.6" = "Control the weight and avoid dropping it quickly.";

"exercise.info.triceps_cable_pushdown.description" = "Cable Pushdown trains the triceps with steady cable tension and is one of the most common triceps isolation exercises.";
"exercise.info.triceps_cable_pushdown.technique.1" = "Stand facing the cable with elbows close to your sides.";
"exercise.info.triceps_cable_pushdown.technique.2" = "Keep the chest lifted and shoulders relaxed.";
"exercise.info.triceps_cable_pushdown.technique.3" = "Push the handle down by extending the elbows.";
"exercise.info.triceps_cable_pushdown.technique.4" = "Avoid leaning your body over the handle to finish reps.";
"exercise.info.triceps_cable_pushdown.technique.5" = "Squeeze briefly near the bottom.";
"exercise.info.triceps_cable_pushdown.technique.6" = "Return under control without letting the elbows drift forward.";

"exercise.info.triceps_rope_pushdown.description" = "Rope Pushdown is a cable pushdown variation that allows a strong lockout and natural wrist position.";
"exercise.info.triceps_rope_pushdown.technique.1" = "Hold both rope ends and stand close enough to keep tension.";
"exercise.info.triceps_rope_pushdown.technique.2" = "Keep elbows pinned near the ribs.";
"exercise.info.triceps_rope_pushdown.technique.3" = "Extend the elbows and separate the rope ends near the bottom.";
"exercise.info.triceps_rope_pushdown.technique.4" = "Keep wrists comfortable and neutral.";
"exercise.info.triceps_rope_pushdown.technique.5" = "Do not swing the torso to move the weight.";
"exercise.info.triceps_rope_pushdown.technique.6" = "Let the rope return slowly while keeping the upper arms still.";

"exercise.info.triceps_two_arm_overhead_dumbbell_extension.description" = "Two-Arm Overhead Dumbbell Extension trains the long head of the triceps with both hands holding one dumbbell overhead.";
"exercise.info.triceps_two_arm_overhead_dumbbell_extension.technique.1" = "Hold one dumbbell overhead with both hands around the handle or plate.";
"exercise.info.triceps_two_arm_overhead_dumbbell_extension.technique.2" = "Keep the ribs down and torso stable.";
"exercise.info.triceps_two_arm_overhead_dumbbell_extension.technique.3" = "Point elbows forward and keep them from flaring too wide.";
"exercise.info.triceps_two_arm_overhead_dumbbell_extension.technique.4" = "Lower the dumbbell behind the head under control.";
"exercise.info.triceps_two_arm_overhead_dumbbell_extension.technique.5" = "Extend the elbows to bring the dumbbell back overhead.";
"exercise.info.triceps_two_arm_overhead_dumbbell_extension.technique.6" = "Use a weight you can control without arching the back.";

"exercise.info.triceps_one_arm_overhead_dumbbell_extension.description" = "One-Arm Overhead Dumbbell Extension is a unilateral triceps exercise that helps train each arm through a full overhead range.";
"exercise.info.triceps_one_arm_overhead_dumbbell_extension.technique.1" = "Hold one dumbbell overhead with one arm.";
"exercise.info.triceps_one_arm_overhead_dumbbell_extension.technique.2" = "Brace the torso and keep the shoulder stable.";
"exercise.info.triceps_one_arm_overhead_dumbbell_extension.technique.3" = "Bend the elbow and lower the dumbbell behind the head.";
"exercise.info.triceps_one_arm_overhead_dumbbell_extension.technique.4" = "Keep the elbow pointing mostly upward.";
"exercise.info.triceps_one_arm_overhead_dumbbell_extension.technique.5" = "Extend back up without letting the wrist collapse.";
"exercise.info.triceps_one_arm_overhead_dumbbell_extension.technique.6" = "Match the same range and control on both arms.";

"exercise.info.triceps_overhead_cable_extension.description" = "Overhead Cable Extension keeps tension on the triceps in an overhead position and targets the long head well.";
"exercise.info.triceps_overhead_cable_extension.technique.1" = "Set the cable low or behind you and take a stable stance.";
"exercise.info.triceps_overhead_cable_extension.technique.2" = "Bring the handle or rope overhead with elbows bent.";
"exercise.info.triceps_overhead_cable_extension.technique.3" = "Keep upper arms angled forward and mostly fixed.";
"exercise.info.triceps_overhead_cable_extension.technique.4" = "Extend the elbows until the arms are nearly straight.";
"exercise.info.triceps_overhead_cable_extension.technique.5" = "Keep the ribs controlled and avoid over-arching.";
"exercise.info.triceps_overhead_cable_extension.technique.6" = "Return slowly and maintain cable tension.";

"exercise.info.triceps_lying_dumbbell_extension.description" = "Lying Dumbbell Extension is a skull-crusher style triceps exercise using dumbbells for independent arm movement.";
"exercise.info.triceps_lying_dumbbell_extension.technique.1" = "Lie on a bench with dumbbells held above the shoulders.";
"exercise.info.triceps_lying_dumbbell_extension.technique.2" = "Keep upper arms steady and elbows pointing upward.";
"exercise.info.triceps_lying_dumbbell_extension.technique.3" = "Lower the dumbbells toward the sides of the head.";
"exercise.info.triceps_lying_dumbbell_extension.technique.4" = "Use a neutral or comfortable grip.";
"exercise.info.triceps_lying_dumbbell_extension.technique.5" = "Extend the elbows without turning it into a press.";
"exercise.info.triceps_lying_dumbbell_extension.technique.6" = "Keep both arms moving evenly and under control.";

"exercise.info.triceps_kickback.description" = "Kickback is a strict triceps isolation exercise usually performed with a dumbbell or cable from a hinged position.";
"exercise.info.triceps_kickback.technique.1" = "Hinge forward with the back flat and torso supported if needed.";
"exercise.info.triceps_kickback.technique.2" = "Keep the upper arm close to the body and roughly parallel to the floor.";
"exercise.info.triceps_kickback.technique.3" = "Extend the elbow until the arm is straight behind you.";
"exercise.info.triceps_kickback.technique.4" = "Pause briefly at the top without swinging.";
"exercise.info.triceps_kickback.technique.5" = "Lower slowly while keeping the shoulder still.";
"exercise.info.triceps_kickback.technique.6" = "Use a light enough load to keep the movement strict.";

"exercise.info.triceps_close_grip_push_up.description" = "Close-Grip Push-Up is a bodyweight triceps-focused push-up variation with the hands placed narrower than usual.";
"exercise.info.triceps_close_grip_push_up.technique.1" = "Set the hands under or slightly inside shoulder width.";
"exercise.info.triceps_close_grip_push_up.technique.2" = "Keep the body in one straight line.";
"exercise.info.triceps_close_grip_push_up.technique.3" = "Lower with elbows close to the ribs.";
"exercise.info.triceps_close_grip_push_up.technique.4" = "Keep the neck neutral and core braced.";
"exercise.info.triceps_close_grip_push_up.technique.5" = "Press back up by extending the elbows.";
"exercise.info.triceps_close_grip_push_up.technique.6" = "Adjust hand spacing if the wrists feel uncomfortable.";

"exercise.info.forearms_wrist_curl.description" = "Wrist Curl trains the wrist flexors on the inside of the forearm with a simple curling motion at the wrist.";
"exercise.info.forearms_wrist_curl.technique.1" = "Sit or stand with the forearms supported and palms facing up.";
"exercise.info.forearms_wrist_curl.technique.2" = "Let the wrists extend slightly under control at the bottom.";
"exercise.info.forearms_wrist_curl.technique.3" = "Curl the weight up by moving only the wrists.";
"exercise.info.forearms_wrist_curl.technique.4" = "Keep the forearms still throughout the set.";
"exercise.info.forearms_wrist_curl.technique.5" = "Pause briefly at the top without lifting the elbows.";
"exercise.info.forearms_wrist_curl.technique.6" = "Lower slowly and avoid bouncing the weight.";

"exercise.info.forearms_reverse_wrist_curl.description" = "Reverse Wrist Curl targets the wrist extensors on the top side of the forearm.";
"exercise.info.forearms_reverse_wrist_curl.technique.1" = "Support the forearms with palms facing down.";
"exercise.info.forearms_reverse_wrist_curl.technique.2" = "Hold the weight with a controlled grip.";
"exercise.info.forearms_reverse_wrist_curl.technique.3" = "Lift the knuckles upward by extending the wrists.";
"exercise.info.forearms_reverse_wrist_curl.technique.4" = "Keep the movement small, strict, and smooth.";
"exercise.info.forearms_reverse_wrist_curl.technique.5" = "Do not lift the forearms off the support.";
"exercise.info.forearms_reverse_wrist_curl.technique.6" = "Lower slowly to the starting position.";

"exercise.info.forearms_reverse_barbell_curl.description" = "Reverse Barbell Curl trains the forearms, brachialis, and biceps using a palms-down grip.";
"exercise.info.forearms_reverse_barbell_curl.technique.1" = "Stand tall and hold the bar with a pronated grip.";
"exercise.info.forearms_reverse_barbell_curl.technique.2" = "Keep elbows close to the sides.";
"exercise.info.forearms_reverse_barbell_curl.technique.3" = "Curl the bar up without swinging the torso.";
"exercise.info.forearms_reverse_barbell_curl.technique.4" = "Keep wrists firm and avoid letting them bend back.";
"exercise.info.forearms_reverse_barbell_curl.technique.5" = "Pause briefly near the top.";
"exercise.info.forearms_reverse_barbell_curl.technique.6" = "Lower under control through the full range.";

"exercise.info.forearms_behind_back_wrist_curl.description" = "Behind-the-Back Wrist Curl is a standing wrist-curl variation that loads the forearm flexors from behind the body.";
"exercise.info.forearms_behind_back_wrist_curl.technique.1" = "Stand holding a barbell behind your body with palms facing backward.";
"exercise.info.forearms_behind_back_wrist_curl.technique.2" = "Keep the arms straight and shoulders relaxed.";
"exercise.info.forearms_behind_back_wrist_curl.technique.3" = "Let the bar roll slightly toward the fingers if comfortable.";
"exercise.info.forearms_behind_back_wrist_curl.technique.4" = "Curl the wrists upward and squeeze the forearms.";
"exercise.info.forearms_behind_back_wrist_curl.technique.5" = "Keep the torso still and avoid shrugging.";
"exercise.info.forearms_behind_back_wrist_curl.technique.6" = "Control the lowering phase and keep the grip secure.";

"exercise.info.forearms_wrist_roller.description" = "Wrist Roller builds forearm endurance and grip strength by rolling a loaded cord up and down.";
"exercise.info.forearms_wrist_roller.technique.1" = "Hold the roller with both hands at about shoulder height or slightly lower.";
"exercise.info.forearms_wrist_roller.technique.2" = "Keep the shoulders down and torso stable.";
"exercise.info.forearms_wrist_roller.technique.3" = "Roll the handle with alternating wrist movements.";
"exercise.info.forearms_wrist_roller.technique.4" = "Keep the movement steady instead of jerky.";
"exercise.info.forearms_wrist_roller.technique.5" = "Lower the weight under control after rolling it up.";
"exercise.info.forearms_wrist_roller.technique.6" = "Use a load that lets you finish the full roll without losing grip.";

"exercise.info.forearms_dead_hang.description" = "Dead Hang develops grip endurance and shoulder control by hanging from a pull-up bar.";
"exercise.info.forearms_dead_hang.technique.1" = "Grip the bar with both hands at a comfortable width.";
"exercise.info.forearms_dead_hang.technique.2" = "Let the body hang while keeping the shoulders controlled.";
"exercise.info.forearms_dead_hang.technique.3" = "Keep the core lightly braced and legs still.";
"exercise.info.forearms_dead_hang.technique.4" = "Avoid twisting or swinging during the hold.";
"exercise.info.forearms_dead_hang.technique.5" = "Breathe steadily while maintaining the grip.";
"exercise.info.forearms_dead_hang.technique.6" = "Step down safely before the grip fully fails.";

"exercise.info.abs_crunch.description" = "Crunch is a basic abdominal exercise that flexes the upper torso toward the pelvis.";
"exercise.info.abs_crunch.technique.1" = "Lie on your back with knees bent and feet on the floor.";
"exercise.info.abs_crunch.technique.2" = "Place hands lightly behind the head or across the chest.";
"exercise.info.abs_crunch.technique.3" = "Curl the upper back off the floor using the abs.";
"exercise.info.abs_crunch.technique.4" = "Keep the lower back close to the floor.";
"exercise.info.abs_crunch.technique.5" = "Avoid pulling the neck with your hands.";
"exercise.info.abs_crunch.technique.6" = "Lower slowly and keep the movement controlled.";

"exercise.info.abs_lying_leg_raise.description" = "Lying Leg Raise trains the lower abs and hip flexors by raising the legs from a lying position.";
"exercise.info.abs_lying_leg_raise.technique.1" = "Lie on your back with legs straight or slightly bent.";
"exercise.info.abs_lying_leg_raise.technique.2" = "Keep the lower back controlled against the floor.";
"exercise.info.abs_lying_leg_raise.technique.3" = "Raise the legs until they are near vertical.";
"exercise.info.abs_lying_leg_raise.technique.4" = "Lower slowly without letting the lower back arch.";
"exercise.info.abs_lying_leg_raise.technique.5" = "Use a smaller range if control is lost.";
"exercise.info.abs_lying_leg_raise.technique.6" = "Keep the movement smooth and avoid swinging the legs.";

"exercise.info.abs_plank.description" = "Plank is an isometric core exercise focused on holding a stable body position.";
"exercise.info.abs_plank.technique.1" = "Set elbows under the shoulders and forearms on the floor.";
"exercise.info.abs_plank.technique.2" = "Step the feet back and form a straight line from head to heels.";
"exercise.info.abs_plank.technique.3" = "Brace the abs and glutes lightly.";
"exercise.info.abs_plank.technique.4" = "Do not let the hips sag or rise too high.";
"exercise.info.abs_plank.technique.5" = "Keep the neck neutral and breathe steadily.";
"exercise.info.abs_plank.technique.6" = "Stop the set when the position starts to break.";

"exercise.info.abs_reverse_crunch.description" = "Reverse Crunch emphasizes the lower portion of the abdominal movement by curling the pelvis upward.";
"exercise.info.abs_reverse_crunch.technique.1" = "Lie on your back with knees bent and feet lifted.";
"exercise.info.abs_reverse_crunch.technique.2" = "Keep the upper body relaxed and stable.";
"exercise.info.abs_reverse_crunch.technique.3" = "Curl the pelvis upward toward the ribs.";
"exercise.info.abs_reverse_crunch.technique.4" = "Avoid using momentum from the legs.";
"exercise.info.abs_reverse_crunch.technique.5" = "Pause briefly at the top.";
"exercise.info.abs_reverse_crunch.technique.6" = "Lower the hips slowly back to the start.";

"exercise.info.abs_bicycle_crunch.description" = "Bicycle Crunch combines trunk flexion and rotation to train the abs and obliques.";
"exercise.info.abs_bicycle_crunch.technique.1" = "Lie on your back with hands lightly behind the head.";
"exercise.info.abs_bicycle_crunch.technique.2" = "Lift the shoulders and bring one knee toward the opposite elbow.";
"exercise.info.abs_bicycle_crunch.technique.3" = "Rotate through the torso instead of pulling the neck.";
"exercise.info.abs_bicycle_crunch.technique.4" = "Extend the other leg under control.";
"exercise.info.abs_bicycle_crunch.technique.5" = "Alternate sides with a steady rhythm.";
"exercise.info.abs_bicycle_crunch.technique.6" = "Slow down if the movement becomes loose or jerky.";

"exercise.info.abs_cable_crunch.description" = "Cable Crunch loads spinal flexion with a cable, making it a common weighted abdominal exercise.";
"exercise.info.abs_cable_crunch.technique.1" = "Kneel or stand facing away from the cable depending on setup.";
"exercise.info.abs_cable_crunch.technique.2" = "Hold the rope or handle near the head.";
"exercise.info.abs_cable_crunch.technique.3" = "Curl the ribs toward the pelvis using the abs.";
"exercise.info.abs_cable_crunch.technique.4" = "Keep the hips mostly fixed.";
"exercise.info.abs_cable_crunch.technique.5" = "Avoid pulling only with the arms.";
"exercise.info.abs_cable_crunch.technique.6" = "Return slowly while keeping tension on the cable.";

"exercise.info.abs_hanging_knee_raise.description" = "Hanging Knee Raise trains the abs by lifting the knees from a hanging position.";
"exercise.info.abs_hanging_knee_raise.technique.1" = "Hang from a bar with a secure grip.";
"exercise.info.abs_hanging_knee_raise.technique.2" = "Keep shoulders controlled and avoid passive swinging.";
"exercise.info.abs_hanging_knee_raise.technique.3" = "Raise the knees toward the chest.";
"exercise.info.abs_hanging_knee_raise.technique.4" = "Curl the pelvis slightly at the top.";
"exercise.info.abs_hanging_knee_raise.technique.5" = "Lower the legs slowly.";
"exercise.info.abs_hanging_knee_raise.technique.6" = "Reset control before starting the next rep.";

"exercise.info.abs_hanging_leg_raise.description" = "Hanging Leg Raise is a harder hanging core exercise that raises straighter legs through a larger range.";
"exercise.info.abs_hanging_leg_raise.technique.1" = "Hang from a bar with the body still.";
"exercise.info.abs_hanging_leg_raise.technique.2" = "Keep the legs straight or slightly bent.";
"exercise.info.abs_hanging_leg_raise.technique.3" = "Raise the legs under control toward hip height or higher.";
"exercise.info.abs_hanging_leg_raise.technique.4" = "Avoid swinging to start the movement.";
"exercise.info.abs_hanging_leg_raise.technique.5" = "Lower slowly through the same path.";
"exercise.info.abs_hanging_leg_raise.technique.6" = "Use knee raises first if full leg raises are not controlled.";

"exercise.info.abs_side_plank.description" = "Side Plank is an isometric exercise for the obliques and lateral core stability.";
"exercise.info.abs_side_plank.technique.1" = "Place one elbow under the shoulder and stack or stagger the feet.";
"exercise.info.abs_side_plank.technique.2" = "Lift the hips until the body forms a straight line.";
"exercise.info.abs_side_plank.technique.3" = "Brace the side of the torso and glutes.";
"exercise.info.abs_side_plank.technique.4" = "Do not let the hips rotate forward or backward.";
"exercise.info.abs_side_plank.technique.5" = "Keep the neck aligned with the body.";
"exercise.info.abs_side_plank.technique.6" = "Repeat the same hold time on both sides.";

"exercise.info.abs_decline_crunch.description" = "Decline Crunch is a crunch variation performed on an incline bench for a larger range of motion.";
"exercise.info.abs_decline_crunch.technique.1" = "Secure the feet on the decline bench.";
"exercise.info.abs_decline_crunch.technique.2" = "Start with the torso lowered under control.";
"exercise.info.abs_decline_crunch.technique.3" = "Curl the upper body up using the abs.";
"exercise.info.abs_decline_crunch.technique.4" = "Avoid sitting all the way up with hip flexors only.";
"exercise.info.abs_decline_crunch.technique.5" = "Keep the neck relaxed.";
"exercise.info.abs_decline_crunch.technique.6" = "Lower slowly and keep tension through the set.";

"exercise.info.abs_ab_wheel_rollout.description" = "Ab Wheel Rollout is a demanding core exercise that trains the abs to resist extension.";
"exercise.info.abs_ab_wheel_rollout.technique.1" = "Start from the knees with the wheel under the shoulders.";
"exercise.info.abs_ab_wheel_rollout.technique.2" = "Brace the abs and keep the ribs down.";
"exercise.info.abs_ab_wheel_rollout.technique.3" = "Roll forward only as far as you can control.";
"exercise.info.abs_ab_wheel_rollout.technique.4" = "Do not let the lower back sag.";
"exercise.info.abs_ab_wheel_rollout.technique.5" = "Pull the wheel back by tightening the abs.";
"exercise.info.abs_ab_wheel_rollout.technique.6" = "Use a shorter range until the full movement is stable.";

"exercise.info.cardio_running.description" = "Running is a rhythmic cardio exercise that builds aerobic endurance and can be tracked by distance and time.";
"exercise.info.cardio_running.technique.1" = "Start with a short warm-up walk or easy jog.";
"exercise.info.cardio_running.technique.2" = "Keep the torso tall with a slight natural lean forward.";
"exercise.info.cardio_running.technique.3" = "Land softly with the foot close to under the body.";
"exercise.info.cardio_running.technique.4" = "Use a comfortable stride instead of reaching too far forward.";
"exercise.info.cardio_running.technique.5" = "Let the arms swing naturally beside the torso.";
"exercise.info.cardio_running.technique.6" = "Increase distance or pace gradually over time.";

"exercise.info.cardio_walking.description" = "Walking is a low-impact cardio exercise for general activity, recovery, and aerobic endurance.";
"exercise.info.cardio_walking.technique.1" = "Walk at a pace that raises breathing while remaining controlled.";
"exercise.info.cardio_walking.technique.2" = "Keep the head up and the torso tall.";
"exercise.info.cardio_walking.technique.3" = "Roll through the foot smoothly from heel to toe.";
"exercise.info.cardio_walking.technique.4" = "Let the arms swing naturally without tensing the shoulders.";
"exercise.info.cardio_walking.technique.5" = "Choose stable footwear and a safe route.";
"exercise.info.cardio_walking.technique.6" = "Build duration and distance gradually.";

"exercise.info.cardio_treadmill.description" = "Treadmill walking or running is gym cardio tracked by session time rather than route distance.";
"exercise.info.cardio_treadmill.technique.1" = "Step onto the side rails before starting the belt.";
"exercise.info.cardio_treadmill.technique.2" = "Begin at an easy speed and increase it gradually.";
"exercise.info.cardio_treadmill.technique.3" = "Look ahead instead of down at the console.";
"exercise.info.cardio_treadmill.technique.4" = "Keep a tall posture and avoid holding the rails while moving.";
"exercise.info.cardio_treadmill.technique.5" = "Use the safety clip when the treadmill has one.";
"exercise.info.cardio_treadmill.technique.6" = "Slow the belt before stepping off.";

"exercise.info.cardio_cycling.description" = "Cycling is an outdoor cardio activity that can be logged by distance and time.";
"exercise.info.cardio_cycling.technique.1" = "Wear a properly fitted helmet for outdoor rides.";
"exercise.info.cardio_cycling.technique.2" = "Set the saddle so the knee stays slightly bent at the bottom of the pedal stroke.";
"exercise.info.cardio_cycling.technique.3" = "Keep a relaxed grip on the handlebars.";
"exercise.info.cardio_cycling.technique.4" = "Pedal smoothly with a steady cadence.";
"exercise.info.cardio_cycling.technique.5" = "Follow traffic rules and stay aware of the route.";
"exercise.info.cardio_cycling.technique.6" = "Increase ride distance and intensity gradually.";

"exercise.info.cardio_stationary_bike.description" = "Stationary Bike is indoor cardio where session time is the primary training measure.";
"exercise.info.cardio_stationary_bike.technique.1" = "Adjust the saddle before starting the session.";
"exercise.info.cardio_stationary_bike.technique.2" = "Keep a slight bend in the knee at the bottom of each pedal stroke.";
"exercise.info.cardio_stationary_bike.technique.3" = "Keep the torso stable and shoulders relaxed.";
"exercise.info.cardio_stationary_bike.technique.4" = "Pedal through a smooth, controlled circle.";
"exercise.info.cardio_stationary_bike.technique.5" = "Choose resistance that matches the planned effort.";
"exercise.info.cardio_stationary_bike.technique.6" = "Lower the pace gradually to finish the session.";

"exercise.info.cardio_elliptical.description" = "Elliptical is low-impact cardio that trains the whole body with a guided stepping motion.";
"exercise.info.cardio_elliptical.technique.1" = "Step onto the pedals only after the machine is stable.";
"exercise.info.cardio_elliptical.technique.2" = "Keep the torso upright and the core lightly braced.";
"exercise.info.cardio_elliptical.technique.3" = "Place the whole foot on each pedal.";
"exercise.info.cardio_elliptical.technique.4" = "Move the handles and pedals with a smooth rhythm.";
"exercise.info.cardio_elliptical.technique.5" = "Avoid leaning heavily on the fixed handles.";
"exercise.info.cardio_elliptical.technique.6" = "Adjust resistance or incline gradually.";

"exercise.info.cardio_rowing_machine.description" = "Rowing Machine is full-body indoor cardio built around a coordinated leg, torso, and arm stroke.";
"exercise.info.cardio_rowing_machine.technique.1" = "Secure the feet and set the damper to a manageable level.";
"exercise.info.cardio_rowing_machine.technique.2" = "Drive first with the legs while keeping the arms straight.";
"exercise.info.cardio_rowing_machine.technique.3" = "Open the torso slightly after the legs extend.";
"exercise.info.cardio_rowing_machine.technique.4" = "Finish the stroke by drawing the handle toward the lower ribs.";
"exercise.info.cardio_rowing_machine.technique.5" = "Return in reverse order: arms, torso, then knees.";
"exercise.info.cardio_rowing_machine.technique.6" = "Keep the back neutral and the stroke smooth.";

"exercise.info.cardio_jump_rope.description" = "Jump Rope is a simple cardio exercise that develops rhythm, coordination, and lower-leg endurance.";
"exercise.info.cardio_jump_rope.technique.1" = "Use a rope length that clears the floor comfortably.";
"exercise.info.cardio_jump_rope.technique.2" = "Jump only high enough for the rope to pass.";
"exercise.info.cardio_jump_rope.technique.3" = "Turn the rope mainly with the wrists.";
"exercise.info.cardio_jump_rope.technique.4" = "Land softly on the balls of the feet.";
"exercise.info.cardio_jump_rope.technique.5" = "Keep the elbows close to the torso.";
"exercise.info.cardio_jump_rope.technique.6" = "Build longer intervals gradually to protect the calves and shins.";

"exercise.info.cardio_stair_climber.description" = "Stair Climber is indoor cardio that simulates climbing stairs and emphasizes the legs and glutes.";
"exercise.info.cardio_stair_climber.technique.1" = "Step onto the machine only after it is stable.";
"exercise.info.cardio_stair_climber.technique.2" = "Stand tall with the core lightly braced.";
"exercise.info.cardio_stair_climber.technique.3" = "Place the whole foot on each step.";
"exercise.info.cardio_stair_climber.technique.4" = "Use the rails for balance, not to support body weight.";
"exercise.info.cardio_stair_climber.technique.5" = "Keep a steady pace you can control.";
"exercise.info.cardio_stair_climber.technique.6" = "Increase speed or resistance gradually.";

"exercise.info.cardio_swimming.description" = "Swimming is a full-body, low-impact cardio activity that can be tracked by distance and time.";
"exercise.info.cardio_swimming.technique.1" = "Choose a stroke and pace that match your swimming ability.";
"exercise.info.cardio_swimming.technique.2" = "Warm up with easy lengths before harder work.";
"exercise.info.cardio_swimming.technique.3" = "Keep the body long and streamlined in the water.";
"exercise.info.cardio_swimming.technique.4" = "Breathe in a regular, controlled rhythm.";
"exercise.info.cardio_swimming.technique.5" = "Push off the wall carefully and stay aware of lane traffic.";
"exercise.info.cardio_swimming.technique.6" = "Build total distance gradually.";

"exercise.info.cardio_ski_erg.description" = "SkiErg is a standing indoor cardio exercise that uses a powerful downward pulling motion.";
"exercise.info.cardio_ski_erg.technique.1" = "Stand with feet about shoulder-width apart.";
"exercise.info.cardio_ski_erg.technique.2" = "Reach up for the handles with relaxed shoulders.";
"exercise.info.cardio_ski_erg.technique.3" = "Pull the handles down by engaging the lats and core.";
"exercise.info.cardio_ski_erg.technique.4" = "Hinge slightly at the hips instead of rounding the back.";
"exercise.info.cardio_ski_erg.technique.5" = "Finish with the hands near the hips, then return smoothly.";
"exercise.info.cardio_ski_erg.technique.6" = "Keep a steady rhythm before adding more power.";
